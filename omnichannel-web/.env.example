# Green Start — frontend environment (PUBLIC config only; never put secrets here)

# Data source: "true" uses in-memory mocks (default, no backend needed);
# "false" calls the real API. Per-module override via VITE_REAL_APIS.
VITE_USE_MOCKS=true

# Comma list of modules to route to the real API even when mocks are on
# (e.g. "dashboard,customers"). Empty = all modules use their current default.
VITE_REAL_APIS=

# Base path the apiClient prefixes to every request.
VITE_API_BASE_URL=/api/v1

# Dev-only: origin the Vite proxy forwards /api to (NestJS gs-api).
VITE_API_ORIGIN=http://localhost:4000
