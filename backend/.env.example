DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4010

# Encryption key for third-party credentials entered in
# Administration -> Integrations (SMTP password, Anthropic API key, ...).
#
# REQUIRED before any credential can be SAVED. Without it the Integrations
# screen refuses to store a secret rather than writing one in plain text;
# everything else in the app still runs.
#
# Either 64 hex characters (a raw 32-byte key) or any long passphrase, which is
# stretched with scrypt. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CHANGING IT makes every stored credential unreadable — the screens then say
# so and the credential has to be entered again. Never commit a real value.
INTEGRATION_SECRET_KEY="change-this-to-a-long-random-string"

# Email sending worker (backend/src/utils/mailWorker.js). Optional.
# MAIL_WORKER_INTERVAL_MS=60000   # 0 switches the worker off entirely
# MAIL_MAX_ATTEMPTS=5             # attempts before a transient failure becomes FAILED
# MAIL_BATCH_SIZE=10              # messages per pass
