DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4010

# Encryption key for third-party credentials entered in
# Administration -> Integrations (SMTP password, Anthropic API key, ...).
#
# REQUIRED before any credential can be SAVED. Without it the Integrations
# screen refuses to store a secret rather than writing one in plain text;
# everything else in the app still runs.
#
# Either 64 hex characters (a raw 32-byte key) or any long passphrase, which is
# stretched with scrypt. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CHANGING IT makes every stored credential unreadable — the screens then say
# so and the credential has to be entered again. Never commit a real value.
INTEGRATION_SECRET_KEY="change-this-to-a-long-random-string"

# Email sending worker (backend/src/utils/mailWorker.js). Optional.
# MAIL_WORKER_INTERVAL_MS=60000   # 0 switches the worker off entirely
# MAIL_MAX_ATTEMPTS=5             # attempts before a transient failure becomes FAILED
# MAIL_BATCH_SIZE=10              # messages per pass

# The public address of the app. Every link mailed out (set-password,
# welcome, agreement signing) is built from this.
APP_BASE_URL=https://teamlink.teamlinks.in

# TeamLink Job Portal (job-portal-app/). JOB_PORTAL_URL is what browsers open;
# JOB_PORTAL_API_URL (optional) is what this server calls, default JOB_PORTAL_URL.
# The two secrets must equal the portal .env values of the same names; generate
# each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOB_PORTAL_URL=http://localhost:4323
# JOB_PORTAL_API_URL=
JOB_PORTAL_SYNC_TOKEN=
JOB_PORTAL_PUSH_SECRET=
# JOB_PORTAL_SYNC_INTERVAL_MS=3600000   # 0 = no hourly sync

# --- Web hardening (security review 2026-10-09) -------------------------------
# Browser origins allowed to call the staff API from another site (comma list).
# Development default: localhost + same site. Production default: APP_BASE_URL.
# Public career / feed / signing endpoints stay open to every site regardless.
# CORS_ORIGINS=https://teamlink.teamlinks.in
# Behind nginx on the same server set TRUST_PROXY=loopback (default: off).
# TRUST_PROXY=loopback

# --- Job publishing (docs/job-publishing/DEPLOYMENT.md) ------------------------------------------------
# The worker (npm run posting-worker) is a separate process. It refuses the real dev.db unless this is 1.
# TL_ALLOW_REAL_POSTING=1
# The Chrome / Edge the worker drives (default: the installed Google Chrome, then Edge). No browser is downloaded.
# PLAYWRIGHT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Private folders OUTSIDE the repo: browser sign-in profiles, screenshots, run logs.
# TL_PORTAL_PROFILE_DIR=
# TL_PORTAL_SCREENSHOT_DIR=
# TL_PORTAL_LOG_DIR=
# A folder of <portal>.json page settings that override the built-in ones (or TL_PORTAL_SELECTORS_NAUKRI=<file>).
# TL_PORTAL_SELECTORS_DIR=
# Run a credential check inside the API process instead of the worker (off by default).
# TL_POSTING_INLINE=0

# --- Communication Automation (docs/communication/) -------------------------------------------------
# Public/LAN address of THIS server as the Android phone / Meta can reach it (used for webhook links, "Register webhooks on the phone").
# APP_BASE_URL=http://192.168.1.10:4010
# WhatsApp QR-link PROTOTYPE (unofficial, can get the number banned). The worker refuses to link a real number on the real database
# unless this is 1. Leave it unset until you have read docs/communication/WHATSAPP.md and chosen a SPARE number.
# TL_ALLOW_REAL_WHATSAPP_QR=1
# Where the (encrypted) QR session is kept. Default: <your home>/.teamlink/whatsapp-qr-session  (never inside the project / git)
# TL_QR_SESSION_DIR=
# Per-login limit of send requests a minute (default 40).
# TL_COMM_SEND_LIMIT=40
# Tests only (sandbox): TEST_MOCK_PORTS=<loopback ports of mock servers>, TL_QR_BAILEYS_MODULE=<fake WhatsApp library>, TL_COMM_GAP_SCALE=0

# --- Added by the final QA pass (2026-10-13). Names only: every one is OPTIONAL; defaults and meaning are in docs/DEPLOY-ENV.md. ---
# Public address used in password-reset / set-password links (falls back to APP_BASE_URL, then http://localhost:5183)
# FRONTEND_URL=https://teamlink.teamlinks.in
# Face check-in worker threads (1..3). Lower it on a small server.
# FACE_WORKERS=1
# Signing secrets for links and portals (each falls back to JWT_SECRET; give each its own random value in production)
# AGREEMENT_LINK_SECRET=
# OFFER_LINK_SECRET=
# PREP_LINK_SECRET=
# LMS_MEDIA_SECRET=
# PARTNER_JWT_SECRET=
# VENDOR_JWT_SECRET=
# Partner / Vendor portals: 1 / 0 (unset = ON outside production, OFF in production). Allowed origins are comma lists.
# PARTNER_PORTAL_ENABLED=0
# VENDOR_PORTAL_ENABLED=0
# PARTNER_PORTAL_ORIGINS=
# VENDOR_PORTAL_ORIGINS=
# Embedded job portal at /jobs: 1 / 0 (unset = ON outside production)
# JOB_PORTAL_EMBED=1
# JOB_PORTAL_PUBLIC_URL=
# General API rate limit (per IP / per user, window in ms). TL_RATE_LIMIT_IN_TEST=1 turns it on inside the test sandbox.
# API_RATE_LIMIT=1
# API_RATE_WINDOW_MS=60000
# API_RATE_IP_MAX=
# API_RATE_USER_MAX=
# TL_RATE_LIMIT_IN_TEST=1
# Password reset / set-password lifetimes and limits
# PASSWORD_RESET_TTL_MIN=30
# SET_PASSWORD_TTL_HOURS=
# PASSWORD_ADMIN_LINK_TTL_MIN=
# PASSWORD_RESET_TRY_MAX=
# PASSWORD_RESET_IP_MAX=
# PASSWORD_RESET_EMAIL_MAX=
# MAX_FAILED_LOGINS=
# LOGIN_LOCK_MINUTES=
# Backups: BACKUP_SCHEDULE=0 turns the daily copy off; BACKUP_HOUR (default 2); BACKUP_DIR
# BACKUP_SCHEDULE=1
# BACKUP_HOUR=2
# BACKUP_DIR=
# Background timers (ms; 0 = off). Defaults are in the code; leave unset unless you know why.
# INTERVIEW_REMINDER_SWEEP_MS=
# PENDING_WORK_SWEEP_MS=
# AUTO_MESSAGES_SWEEP_MS=
# ATTENDANCE_ALERTS_INTERVAL_MS=
# ATTENDANCE_TASKS_INTERVAL_MS=
# ATS_ESCALATION_SWEEP_MS=
# DAILY_REPORT_MAIL_SWEEP_MS=
# PAYROLL_SYNC_SWEEP_MS=
# SEAT_SWEEP_MS=
# BULK_WORKER_INTERVAL_MS=
# Warm-ups after a restart (candidate list, reports): 0 switches off
# CANDIDATE_WARMUP=1
# REPORT_WARMUP=1
# Accounts service link
# ACCOUNTS_API_URL=
# ACCOUNTS_SERVICE_TOKEN=
# AI: AI_PROVIDER=claude or ollama (default: local Ollama). Also OLLAMA_BASE_URL, OLLAMA_MODEL, OLLAMA_EMBED_MODEL, OLLAMA_TIMEOUT_MS, OLLAMA_NUM_CTX
# AI_PROVIDER=
# OLLAMA_BASE_URL=http://localhost:11434
# Folders OUTSIDE the project for uploads and exports (defaults are under backend/)
# UPLOAD_DIR=
# ATS_IO_DIR=
# MESSAGE_JOB_DIR=
# SYSTEM_STATE_DIR=
# Retired switch: 1 re-opens the old "BDE asks the TL to close / assign" requests (default: off, the BDE does it directly)
# BDE_JOB_REQUESTS=0
# Development only: ALLOW_PRIVATE_FETCH=1 lets the server fetch private addresses. NEVER on a production server.
# Comma list of extra starting passwords that must be treated as "not yet changed"
# TL_SEED_PASSWORDS=

# Green Start (the founder's own Omni-Channel product, unchanged, in green-start-app/). Local computer only; started with
# green-start-app/run/start-green-start.cmd. Clicking Omni-Channel opens it for Admin / Manager / TL / HR logins (it has no phone / email
# masking); BDE, BDE TL, Recruiter and Marketing keep the native Omni-Channel pages. Its entrance is its own port (GREENSTART_GATE_PORT),
# reached with a signed cookie that /api/omni-gs/session hands to a signed-in TeamLink login. false = switched off.
GREENSTART_ENABLED=false
# GREENSTART_GATE_PORT=5190
# GREENSTART_API_PORT=4020
# GREENSTART_REDIS_PORT=6379
# GREENSTART_PG_PORT=5436
# GREENSTART_ALL_ROLES=1   (founder's decision only: also opens Green Start for BDE, BDE TL, Recruiter and Marketing)
# --- Green Start on the LIVE site (leave all of these out on the PC: localhost then behaves as before) ---
# GREENSTART_SUPERVISE=false      the live server: Green Start runs as its own service (systemd); TeamLink starts / stops / watches nothing.
#                                 GREENSTART_ENABLED stays true there, because the door-pass check (/api/omni-gs/verify) needs it.
# GREENSTART_COOKIE_DOMAIN=.teamlinks.in   the door pass cookie (tl_gs) is also sent to greenstart.teamlinks.in. Also makes it Secure and 8 hours.
# GREENSTART_COOKIE_SECURE=1      always add Secure to the door pass (the live nginx does not send X-Forwarded-Proto, so this is decided here).
# GREENSTART_COOKIE_HOURS=8       lifetime of the door pass, 1 to 24 (default 2 on the PC, 8 when GREENSTART_COOKIE_DOMAIN is set).
# GREENSTART_WEB_DIR=/opt/green-start/green-start-web/dist   where the built Green Start screens are (so the status says "built").
# GREENSTART_PG_PORT=5432         (live: the server's own PostgreSQL port; the PC uses 5436)
# The address the sidebar Omni-Channel opens is chosen when the FRONTEND is built (frontend/.env, not this file):
# VITE_GREENSTART_URL=            empty = the live host (*.teamlinks.in) opens https://greenstart.teamlinks.in in a new tab, localhost keeps the in-page frame.
#                                 'local' = always the in-page frame; any address = open that address in a new tab.

# --- RCS MESSAGING (rcssms.in, 2026-10-30) --------------------------------------------------------------------------------------------
# Used ONLY by the server (utils/rcsService.js). Never shown on a screen, never logged. On the VPS: .\set-rcs-credentials-on-vps.ps1
RCS_BASE_URL=https://web.rcssms.in
RCS_USERNAME=
RCS_PASSWORD=
RCS_ID=230
# password (the login goes in every request) | token (Basic username:client-secret -> /api/rcs/accesstoken, then Bearer)
RCS_AUTH_MODE=password
RCS_CLIENT_SECRET=
# the provider document does not say GET or POST for the token address
RCS_TOKEN_METHOD=POST
# The "apitype" of the two send addresses. EMPTY ON PURPOSE: the sending document says 2, the brief says 1. Set it only after
# rcssms.in confirms; until then that kind of send is refused.   same words to many: /rcsapi/jsonapi.jsp   per person: /rcsapimtpl/jsonapi.jsp
RCS_SEND_APITYPE=
RCS_PERSONAL_APITYPE=
# the ?token= of https://<site>/api/webhooks/rcs (give that full address to rcssms.in for template approvals + delivery reports)
RCS_WEBHOOK_SECRET=
# RCS_CHUNK_DELAY_MS=1500   wait between requests of 500 numbers      RCS_QUEUE=off   stops the background queue
