DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4010

# Encryption key for third-party credentials entered in
# Administration -> Integrations (SMTP password, Anthropic API key, ...).
#
# REQUIRED before any credential can be SAVED. Without it the Integrations
# screen refuses to store a secret rather than writing one in plain text;
# everything else in the app still runs.
#
# Either 64 hex characters (a raw 32-byte key) or any long passphrase, which is
# stretched with scrypt. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# CHANGING IT makes every stored credential unreadable — the screens then say
# so and the credential has to be entered again. Never commit a real value.
INTEGRATION_SECRET_KEY="change-this-to-a-long-random-string"

# Email sending worker (backend/src/utils/mailWorker.js). Optional.
# MAIL_WORKER_INTERVAL_MS=60000   # 0 switches the worker off entirely
# MAIL_MAX_ATTEMPTS=5             # attempts before a transient failure becomes FAILED
# MAIL_BATCH_SIZE=10              # messages per pass

# The public address of the app. Every link mailed out (set-password,
# welcome, agreement signing) is built from this.
APP_BASE_URL=https://teamlink.teamlinks.in

# TeamLink Job Portal (job-portal-app/). JOB_PORTAL_URL is what browsers open;
# JOB_PORTAL_API_URL (optional) is what this server calls, default JOB_PORTAL_URL.
# The two secrets must equal the portal .env values of the same names; generate
# each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOB_PORTAL_URL=http://localhost:4323
# JOB_PORTAL_API_URL=
JOB_PORTAL_SYNC_TOKEN=
JOB_PORTAL_PUSH_SECRET=
# JOB_PORTAL_SYNC_INTERVAL_MS=3600000   # 0 = no hourly sync

# Single sign-on to the Job Portal ("Job Portal" in the sidebar, Recruiter and
# Admin). HRMS_SSO_SECRET must equal HRMS_SSO_SECRET in the portal's .env (the
# embedded portal gets it automatically). At least 32 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Empty = the item is hidden and /api/sso answers 503. Never commit the value.
HRMS_SSO_SECRET=
# Sign-ins end after this many minutes without user activity; the Job Portal
# shares the same timer.
# SESSION_IDLE_MINUTES=30
# Where browsers open the portal when it is NOT embedded at <APP_BASE_URL>/jobs.
# JOB_PORTAL_PUBLIC_URL=https://jobs.teamlinkcs.com
