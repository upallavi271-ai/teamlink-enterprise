generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so these are plain strings.
// Valid values, enforced in application code (see backend/src/routes):
// Role: SUPER_ADMIN | ADMIN | MANAGER | ASSISTANT_MANAGER | STL | TL | RECRUITER | BDE | CLIENT | ACCOUNTANT | EMPLOYEE
// Priority: Low | Medium | High | Urgent (the prototype's Create Requirement list)
// RequirementStatus: DRAFT | OPEN | CLOSED
// ApplicationStage: NEW | AI_INTERVIEW_REQUIRED | AI_INTERVIEW_SCHEDULED | AI_INTERVIEW_COMPLETED |
//   RECRUITER_REVIEW | RECRUITER_APPROVED | WITH_BDE | BDE_APPROVED | SHARED_WITH_CLIENT |
//   CLIENT_REVIEW | CLIENT_SHORTLISTED | INTERVIEW_SCHEDULED | INTERVIEW_COMPLETED | SELECTED | OFFER |
//   OFFER_ACCEPTED | JOINED | HIRED | REJECTED | HOLD
// InterviewStatus: SCHEDULED | CONFIRMED | STARTED | COMPLETED | PENDING_FEEDBACK |
//   CANCELLED | NO_SHOW | RESCHEDULED
//   (the prototype's recruitment/client interview chain — see
//    backend/src/utils/atsVocab.js INTERVIEW_STATUS_LABELS / INTERVIEW_NEXT)
// AgreementStatus: DRAFT | SENT | CONFIRMED | ACTIVE | CANCELLED | EXPIRED
//   (the reference prototype's agreement lifecycle — a client requirement can
//    only be activated or posted once its agreement reaches ACTIVE)
//
// Stage codes are stored; the exact label a user reads for each one lives in
// backend/src/utils/atsVocab.js (STAGE_LABELS) and is taken verbatim from the
// prototype. Never derive a label from a code.

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  passwordHash  String
  // ONE EMPLOYEE = ONE USER = ONE LOGIN. `role` is the login's primary role
  // code (SUPER_ADMIN … EMPLOYEE, CLIENT, CANDIDATE). It is not read directly
  // by route guards any more: every guard goes through the permission engine
  // in backend/src/utils/permissions.js, which resolves role -> RoleAccess
  // matrix -> action, then applies data scope.
  role          String
  atsDepartment String?
  clientId      String?
  client        Client? @relation(fields: [clientId], references: [id])

  // --- Identity & access (auth_rbac) -------------------------------------
  // External candidate logins point at a Candidate row instead of an Employee.
  // Plain scalar (no Prisma relation) so the migration stays ADD COLUMN only.
  candidateId String?

  // Product access. Independent booleans — not every employee has every
  // product. Null/absent is treated as "derive from designation" only at seed
  // time; at runtime these are authoritative.
  hrmsAccess     Boolean @default(false)
  atsAccess      Boolean @default(false)
  accountsAccess Boolean @default(false)

  // ---------------------------------------------------------------------
  // THREE INDEPENDENT PRODUCT ROLES. One login, three products, three roles.
  //
  //   USER
  //    ├── HRMS Role      → hrmsRole      (e.g. EMPLOYEE)
  //    ├── ATS Role       → atsRole       (e.g. RECRUITER)
  //    └── Accounts Role  → accountsRole  (e.g. NONE)
  //
  // Being an Employee in HRMS must NOT deny Recruiter actions in ATS, so the
  // permission engine resolves the role for the PRODUCT being asked about
  // (utils/permissions.js roleForProduct) rather than reading `role`.
  //
  // 'NONE' (or null with the product boolean off) means "no access to this
  // product". Each is DERIVED from the employee's designation via the
  // DesignationRole mapping table, or overridden per-user here. Never a
  // department-qualified string like "Medical TL" — just "TL"; the department
  // supplies the scope, never the role name.
  hrmsRole            String?
  atsRole             String?
  accountsRole        String?
  // Data scope. Comma-separated; empty/null means "the employee's own
  // department / team". STLs carry several departments here.
  atsScopeDepartments String?
  atsScopeTeams       String?
  atsScopeClients     String?
  // Preferred landing workspace when several products are available.
  landingWorkspace    String?

  // --- emplife: single-use "set your password" link -----------------------
  // HR never emails a password. Creating an employee issues a one-time token;
  // only its SHA-256 hash is stored, it expires, and it is burned on use.
  setPasswordTokenHash String?
  setPasswordExpiresAt DateTime?
  setPasswordUsedAt    DateTime?
  // Client portal login type (spec B1, 2026-10-03): REVIEWER | VIEWER | BILLING.
  // CLIENT logins only; null = a client login created before types existed.
  portalType           String?
  // Last time an Admin confirmed this client login is still needed (quarterly review).
  portalReviewedAt     DateTime?

  // Login administration — the prototype's Users screen (usersView, line 9893).
  username    String?
  status      String    @default("Active") // Active | Inactive | Suspended
  branch      String?
  team        String?
  lastLoginAt DateTime?
  // Password status (hrms-24 §12). Never the password: only WHEN it changed,
  // whether a reset is outstanding, and the lockout counters the login uses.
  passwordChangedAt     DateTime?
  passwordResetRequired Boolean   @default(false)
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requirementsAsRecruiter Requirement[]  @relation("RecruiterRequirements")
  requirementsAsBde       Requirement[]  @relation("BdeRequirements")
  auditLogs               AuditLog[]
  employee                Employee?
  notifications           Notification[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  location  String?
  createdAt DateTime @default(now())

  // Company / classification — the prototype's Add Client "Basic Info" tab.
  legalName       String?
  website         String?
  ownerDepartment String?
  yearEstablished String?
  landline        String?
  status          String? @default("Active") // Active | Inactive | Suspended
  activeDate      String?
  clientType      String? // Direct | Vendor | Partner
  priority        String? @default("High") // High | Medium | Low

  // Primary / secondary contact.
  contactName                 String?
  contactDesignation          String?
  contactPhone                String?
  contactEmail                String?
  contactWhatsApp             String?
  secondaryContactName        String?
  secondaryContactDesignation String?
  secondaryContactPhone       String?
  secondaryContactEmail       String?
  commPrimary                 String? // Email | WhatsApp | Phone
  commSecondary               String?
  commChannels                String? // comma-separated: Email,WhatsApp,SMS

  // Address.
  houseNumber String?
  street      String?
  landmark    String?
  area        String?
  pincode     String?
  country     String? @default("India")
  state       String?

  // Legal & finance — the prototype's "Legal & Finance" tab. These drive both
  // the agreement document and the invoice raised when a candidate joins.
  gst             String?
  pan             String?
  tan             String?
  businessType    String? @default("Private Limited")
  tdsPercent      Float?  @default(10)
  gstPercent      Float?  @default(18)
  paymentTerms    String? @default("Invoice 6 days after joining; payment due within 6 days of invoice")
  guaranteePeriod String? @default("30 Days")
  invoiceTrigger  String? @default("Candidate Joining")
  paymentDue      String? @default("6 days after invoice")
  commercialNotes String?
  accountManager  String?
  bdeOwner        String?

  // Risk monitoring tab.
  riskFlag  String? @default("None") // None | Watch | High Risk
  riskNotes String?

  // Service agreement / e-sign flow. The document is generated from the client
  // record, sent for signature, confirmed either by the client's own login or
  // through the tokenised public signing link (see routes/public.js), and then
  // activated — which is what unblocks requirements for this client.
  agreementId            String?   @unique // human-readable reference, e.g. AGR0001
  agreementStatus        String    @default("DRAFT") // DRAFT | SENT | CONFIRMED | ACTIVE | CANCELLED | EXPIRED
  agreementRequired      String?   @default("Yes")
  agreementTemplate      String?   @default("Standard Recruitment / Staffing")
  agreementStart         String?
  agreementEnd           String?
  agreementActivatedAt   DateTime?
  agreementDocument      String? // generated agreement text
  agreementFeePercent    Float?    @default(8.33) // placement fee, % of annual CTC
  esignToken             String?   @unique // opaque token in the client-facing signing link
  agreementSentAt        DateTime?
  agreementViewedAt      DateTime?
  agreementSignedAt      DateTime?
  agreementSignedBy      String? // full name typed at e-sign time
  agreementSignedByTitle String? // signatory designation

  // --- clireq: client profile depth -------------------------------------
  // The Client Detail screen's Overview tab. A client carries a human-readable
  // code, a billing contact and a recruitment contact in addition to the
  // primary/secondary commercial contacts above.
  clientCode                    String? @unique
  billingContactName            String?
  billingContactDesignation     String?
  billingContactEmail           String?
  billingContactPhone           String?
  recruitmentContactName        String?
  recruitmentContactDesignation String?
  recruitmentContactEmail       String?
  recruitmentContactPhone       String?

  // --- clireq: agreement workflow depth ---------------------------------
  // Draft -> Sent -> Viewed -> Client Confirmation Pending -> Signed -> Active,
  // with Expired and Rejected as terminal states. agreementSource records
  // whether the document was generated from the template or uploaded.
  agreementSource                  String?   @default("Generated")
  agreementConfirmationRequestedAt DateTime?
  agreementRejectedAt              DateTime?
  agreementRejectedReason          String?
  agreementSignedCopyName          String?
  agreementSignedCopyNote          String?

  // --- The executed agreement: both seals, and a verified signature -----
  //
  // We stamp and sign before sending; the client stamps and signs on the
  // signing page; then the client verifies who they are before it counts.
  agreementCompanyStampFile String?
  agreementCompanyStampName String?
  agreementCompanySignFile  String?
  agreementCompanySignName  String?
  agreementCompanySignedBy  String?
  agreementCompanySealedAt  DateTime?

  agreementClientStampFile String?
  agreementClientStampName String?
  agreementClientSignFile  String?
  agreementClientSignName  String?
  agreementClientSealedAt  DateTime?

  agreementVerifyMethod  String? // AADHAAR | ALTERNATIVE
  // THE FULL AADHAAR NUMBER IS NEVER STORED. Section 29 of the Aadhaar Act
  // forbids an unauthenticated entity retaining it. The last four digits are
  // for display; the provider transaction id is what proves the signature.
  agreementAadhaarLast4  String?
  agreementEsignTxnId    String?
  agreementLinkMeta      String? // agreement link settings "LINK;d=14;m=1;r=…" (utils/agreementSigning.js linkMeta)
  agreementEsignProvider String?
  agreementVerifyMobile  String? // masked for display
  agreementVerifiedAt    DateTime?
  // Hashed, expiring, attempt-counted — never the OTP itself. A plaintext
  // column here would make the database a way to sign an agreement.
  agreementOtpHash       String?
  agreementOtpExpiresAt  DateTime?
  agreementOtpAttempts   Int       @default(0)
  agreementVerifyNote    String?

  // --- Add Client in 9 sections (2026-10-05) ---------------------------
  companyType          String? // Corporate | MNC | Startup | SME | Consultancy | Other
  companyEmail         String?
  contactAltPhone      String?
  secondaryBde         String?
  clientSource         String? // BDE | Referral | Website | Existing Client | Other
  feeType              String? // PERCENT_CTC | FIXED | PER_CANDIDATE
  feeAmount            Float? // Rs. when feeType is FIXED / PER_CANDIDATE
  gstApplicable        String? // Yes | No
  tdsApplicable        String? // Yes | No
  replacementTerms     String?
  specialTerms         String? // printed in the agreement (clause 17)
  billingAddress       String?
  billingSameAsAddress Boolean?
  billingEmail         String?
  invoiceEmail         String?
  paymentMethod        String?
  paymentBankName      String?
  paymentUpi           String?
  paymentReferenceNote String?
  bankAccountHolder    String?
  bankAccountNoEnc     String? // AES-256-GCM (utils/secrets.js), never sent to a browser
  bankAccountLast4     String?
  bankIfsc             String?
  // Internal only — never shown to the client (agreement, link page, PDF, portal, emails).
  internalNotes           String?
  specialInstructions     String?
  recruitmentInstructions String?
  internalRemarks         String?
  documents            ClientDocument[]
  requirements Requirement[]
  users        User[]
  invoices     Invoice[]
}

model ClientDocument {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind           String   @default("OTHER") // AGREEMENT | GST | REGISTRATION | PAN | OTHER
  name           String
  fileStored     String // utils/attachments.js stored name
  fileName       String?
  fileMime       String?
  fileSize       Int?
  expiryDate     String? // YYYY-MM-DD
  pending        Boolean  @default(false)
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
}

model Requirement {
  id             String  @id @default(cuid())
  title          String
  description    String?
  clientId       String
  client         Client  @relation(fields: [clientId], references: [id])
  department     String?
  // The specialisation inside that department — Medical -> Dermatology.
  // Nullable: most departments do not use one.
  specialisation String?
  priority       String  @default("Medium")
  status         String  @default("OPEN") // DRAFT | OPEN | CLOSED
  skills         String? // comma-separated MANDATORY skills, drives candidate matching + JD
  experience     String? // e.g. "5-8" years, shown on the generated job description
  openings       Int     @default(1)

  // Prototype Create Requirement form (openAddRequirementModal / collectRequirementForm).
  internal           Boolean @default(false) // Internal Requirement vs Client Requirement
  hiringType         String? // Client Placement | TeamLink Internal Hire — the stored form of `internal`
  closingDate        String?
  jobDescription     String?
  responsibilities   String?
  qualifications     String?
  education          String? @default("Any Degree")
  goodToHaveSkills   String? // comma-separated
  employmentType     String? @default("Full Time")
  workMode           String? @default("Work From Office")
  location           String?
  preferredLocation  String? @default("Any")
  relevantExperience String?
  joiningTimeline    String? @default("Within 15 Days")
  noticePeriodMax    String? @default("30 Days")
  jobPreference      String? @default("Permanent")
  salaryType         String? @default("Annual CTC")
  currency           String? @default("INR")
  salary             String? // rendered band, e.g. "₹14L - ₹20L"
  tl                 String?
  stl                String?
  postingSources     String? // comma-separated selected posting sources
  // --- clireq: requirement identity, assignment and portal sync ---------
  // reqCode is the human-facing Requirement ID (REQ-0004). tlId / stlId /
  // recruiterIds are plain scalars, NOT Prisma relations, so the migration
  // stays ADD COLUMN only - the same pattern User.candidateId uses. They are
  // what utils/scope.js filters on: a recruiter sees the requirements they are
  // assigned, a TL the ones they lead, a BDE the ones they own.
  reqCode            String? @unique
  tlId               String?
  stlId              String?
  recruiterIds       String? // comma-separated additional recruiter user ids
  targetDate         String?
  accountManager     String?
  portalSyncStatus   String? @default("Not Synced") // Not Synced | Pending | Synced | Failed

  // --- portal_: the Job Portal workspace inside Jobs / Requirements -------
  // PUBLISHED is a decision someone makes and is recorded with who and when;
  // it is NOT the same thing as "live". A requirement can be OPEN and not
  // published, and a published one that is later closed stops being offered
  // without the publishing record being erased. portalSyncStatus (above) is
  // the separate question of whether the posting has been pushed out since it
  // last changed. Plain scalars, so the migration stays ADD COLUMN only.
  portalPublished     Boolean   @default(false)
  portalPublishedAt   DateTime?
  portalPublishedBy   String? // user id of whoever published it
  portalUnpublishedAt DateTime?

  // THE SEAT that owns this requirement, beside the person. A requirement
  // worked by MED-1 stays MED-1 work after the person in MED-1 changes.
  positionId   String?
  position     Position? @relation(fields: [positionId], references: [id])
  // Snapshotted, because a position can be renamed and this must still say
  // what it said at the time.
  positionCode String?
  recruiterId  String?
  recruiter    User?     @relation("RecruiterRequirements", fields: [recruiterId], references: [id])
  bdeId        String?
  bde          User?     @relation("BdeRequirements", fields: [bdeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications Application[]
  invoices     Invoice[]
  postings     RequirementPosting[] // Save & Post: one row per posting source

  // ATS dashboard performance (migration 20260926140000_ats_dashboard_indexes).
  @@index([clientId])
  @@index([recruiterId])
  @@index([tlId])
  @@index([department])
  // spec_: master Qualification / Specialisation ids (old free text stays as "old value").
  qualificationId  String?
  specialisationId String?
  minFit           Int? // fit_: minimum Overall Fit % for "Eligible"; null = Admin default (50)

  @@index([specialisationId])
}

// Save & Post (2026-10-05): the result of publishing a job on one posting
// source (utils/jobConnectors.js). One row per (job, source); the master job
// is Requirement.id, so a source never gets a second requirement.
model RequirementPosting {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  source        String // jobportal | website | google | naukri | indeed | shine
  status        String      @default("Pending") // Posted | Failed | Integration Required | Pending | Removed
  externalJobId String? // the board's own id for the job (ours for our own sites)
  externalUrl   String? // where candidates see it
  postedAt      DateTime? // first confirmed Posted (kept across updates)
  removedAt     DateTime?
  errorMessage  String? // plain words; never a credential
  attempts      Int         @default(0)
  lastTriedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([requirementId, source])
  @@index([source, status])
}

model Candidate {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  source          String?  @default("TeamLink Website")
  skills          String? // comma-separated MANDATORY skills, scored against Requirement.skills
  experienceYears Float?
  createdAt       DateTime @default(now())

  // Prototype Add Candidate form (openAddCandidateModal / acCollectCandidate).
  // These are the signals the prototype's computeMatch() actually scores on —
  // see backend/src/utils/matching.js.
  dob                     String?
  gender                  String?
  location                String?
  preferredLocation       String?
  currentCompany          String?
  currentDesignation      String?
  relevantExperienceYears Float?
  currentSalary           String?
  expectedSalary          String?
  noticePeriod            String? @default("30 Days")
  availability            String? @default("Available after notice period")
  jobPreference           String? @default("Permanent")
  preferredEmploymentType String? @default("Full Time")
  preferredWorkMode       String? @default("Hybrid")
  education               String?
  specialization          String?
  institute               String?
  passingYear             String?
  goodToHaveSkills        String? // comma-separated
  technicalSkills         String? // comma-separated
  softSkills              String? // comma-separated
  resumeName              String?
  resumeScore             Int?
  firstSource             String?
  sourceCampaign          String?
  profileStatus           String? @default("Active")
  // A STABLE REFERENCE FROM THE SOURCE SYSTEM, for a candidate who arrives
  // with no email and no phone. Several of the real recruitment sheets have
  // no contact column at all; this is what lets those rows be imported and
  // RE-imported without either duplicating people or merging two people who
  // happen to share a name. Null for everybody keyed the ordinary way.
  externalRef             String?

  applications Application[]
  invoices     Invoice[]
  // cand_: virtual back-references only — no column is added to Candidate.
  stageEvents  ApplicationStageEvent[]
  messages     CandidateMessage[]
  notes        CandidateNote[]
  documents    CandidateDocument[]
  // resume_: virtual back-reference only — no column is added to Candidate.
  resumes      CandidateResume[]
  // spec_: master Qualification / Specialisation ids.
  qualificationId  String?
  specialisationId String?

  @@index([externalRef])
  @@index([createdAt])
  @@index([specialisationId])
  // b5_: CONSENT (null consentStatus = "Not recorded" — never faked for imports)
  consentStatus        String? // GIVEN | NOT_GIVEN | WITHDRAWN
  consentPurposes      String? // comma list: Recruitment, Messages, Share with clients
  consentAt            DateTime?
  consentSource        String? // portal | careers | recruiter | import | referral
  consentProof         String? // form version / IP / recruiter note
  consentWithdrawnAt   DateTime?
  consentByName        String?
  doNotContact         Boolean   @default(false) // set on Withdrawn: bulk sends / exports skip
  // b5_: referred by (an employee id, or only a name for an outside person)
  referredByEmployeeId String?
  referredByName       String?
  // b6_: the campus drive they were added from
  campusDriveId        String?
  certifications       CandidateCertification[]
  @@index([campusDriveId])
  // b7_: partner ownership (first-submitter wins for Partner.ownershipDays)
  ownerPartnerId       String?
  ownerUntil           DateTime?
  ownerSubmissionId    String?
  @@index([ownerPartnerId])
}

model Application {
  id              String      @id @default(cuid())
  candidateId     String
  candidate       Candidate   @relation(fields: [candidateId], references: [id])
  requirementId   String
  requirement     Requirement @relation(fields: [requirementId], references: [id])
  stage           String      @default("NEW")
  interviewStatus String?
  interviewAt     DateTime?

  // Recruitment / client interview detail — the prototype's `application.interview`
  // object (recruitmentInterviewTab, line 9330). Kept on Application rather than in
  // a parallel model so interviewStatus/interviewAt stay the single source of truth.
  interviewCode            String? // INT-#### shown in the calendar's first column
  interviewRound           Int                     @default(1)
  interviewType            String? // Client Interview | Internal Panel
  interviewer              String?
  interviewMode            String? // Online | In Person | Telephonic
  interviewLocation        String?
  interviewMeetingLink     String?
  interviewScore           Int? // recruitment/client score — never mixed with aiInterviewScore
  interviewResult          String? // Recommended | Hold | Not Selected
  interviewFeedback        String?
  interviewCreatedBy       String?
  interviewCancelReason    String?
  interviewRescheduleCount Int                     @default(0)
  interviewStartedAt       DateTime?
  interviewCompletedAt     DateTime?
  interviewEvents          InterviewEvent[]
  // cand_: virtual back-reference only — no column is added to Application.
  stageEvents              ApplicationStageEvent[]
  // followup_: virtual back-reference only — no column is added to Application.
  followUps                ApplicationFollowUp[]

  // AI interview detail (the calendar's second tab).
  aiInterviewDeadline String?
  aiInterviewFeedback String?

  // Per-application detail the prototype's pipeline columns read from.
  matchScore        Int?
  matchVersion      String? // B8: "fit-v3" = scoring version of matchScore; null = v1 (before versioning)
  matchDetail       String? // B8: JSON { version, weights, specBonus, semantic, reasons, gaps, eligible, why, minFit, at }
  overrideReason    String? // B8: an INELIGIBLE candidate added anyway — the reason given
  overrideAt        DateTime?
  overrideById      String?
  overrideByName    String?
  resumeScore       Int?
  source            String?
  firstSource       String?
  sourceCampaign    String?
  applicationMethod String?   @default("Manual") // Manual | Auto-Apply
  // --- portal_: Job Portal intake ----------------------------------------
  // An application whose `source` is PORTAL_APPLICATION_SOURCE arrived from a
  // job portal form rather than from a recruiter keying it in. It is already a
  // real pipeline row (that is how intake works today); "Import to ATS" is the
  // separate, recorded act of a recruiter ADMITTING it — assigning it to the
  // requirement's recruiter and moving it off NEW. These two columns are that
  // record, so an un-imported portal application can always be told apart from
  // one a recruiter has already picked up.
  portalImportedAt  DateTime?
  portalImportedBy  String? // user id of whoever imported it
  aiInterviewStatus String?   @default("Required")
  aiInterviewScore  Int?
  // Client joining -> Accounts hand-off (prototype confirmClientJoining).
  offeredCtc        Float?
  joiningDate       String?

  // --- Interviews & Joining (Offers / Joining / Internal Hiring) -----------
  // Hiring Type is the fork the whole downstream flow turns on, and it is
  // stored, never guessed at render time:
  //   Client Placement       Selected -> Offer -> Joined Client -> Accounts
  //                          -> Invoice -> Receivable
  //   TeamLink Internal Hire Selected -> Internal Offer -> Accepted -> Hired
  //                          -> HRMS Employee Creation
  // Only a client placement ever raises an invoice; only an internal hire ever
  // becomes an HRMS employee. See backend/src/utils/joining.js.
  hiringType         String? // Client Placement | TeamLink Internal Hire
  offerStatus        String? // Not Issued | Offer Released | Offer Accepted | Offer Declined
  offerDate          String?
  offerNotes         String?
  offerAcceptedAt    DateTime?
  documentsStatus    String? // Pending | Submitted | Verified
  joiningStatus      String? // Not Scheduled | Joining Scheduled | Joined | Dropped
  joinedAt           DateTime?
  billingStatus      String? // Not Applicable | Billing Pending | Invoiced
  hrmsEmployeeId     String? // Employee row created for a TeamLink internal hire
  interviewFeedbacks InterviewFeedback[]
  offerVersions      OfferVersion[]
  interviewPanelists InterviewPanelist[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([candidateId, requirementId])
  // ATS dashboard performance (migration 20260926140000_ats_dashboard_indexes).
  @@index([requirementId])
  @@index([stage])
  @@index([createdAt])
  @@index([interviewAt])
  @@index([overrideAt])
  // b6_: campaign / UTM, referral, campus
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  referralId           String?
  referredByEmployeeId String?
  referredByName       String?
  campusDriveId        String?
  @@index([utmCampaign])
  @@index([referralId])
  @@index([campusDriveId])
  // b7_: the partner submission this application came from
  partnerId            String?
  partnerSubmissionId  String?
  @@index([partnerId])
}

// Every status move a recruitment/client interview makes, kept in full — the
// prototype's `interview.history` + `interview.rescheduleHistory`. Nothing is
// overwritten silently: a reschedule appends rather than replacing the slot.
model InterviewEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String // the status this event moved the interview to
  reason        String? // cancellation / reschedule / no-show reason
  fromSlot      String? // previous date+time, on a reschedule
  toSlot        String? // new date+time, on a reschedule
  by            String? // who did it
  createdAt     DateTime    @default(now())
}

// Interview feedback. INTERNAL feedback and CLIENT feedback are two separate
// records on the same interview and are never merged into one another — and
// neither is ever mixed with the AI interview score, which lives in
// Application.aiInterviewScore.
model InterviewFeedback {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind           String // Internal | Client
  technical      Int? // Technical Skills, 1-5
  communication  Int? // Communication, 1-5
  experience     Int? // Experience, 1-5
  roleFit        Int? // Role Fit, 1-5
  overall        String // Overall Feedback
  recommendation String // Selected | Rejected | Hold
  submittedById  String?
  submittedBy    String?
  clientId       String? // set on client feedback, so a client only ever reads its own
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([applicationId, kind])
}

// B3 (2026-10-06): every offer letter sent is a VERSION. Re-issuing keeps the
// old one (status Replaced). The candidate's e-sign link: tokenHash = sha256 of
// an HMAC-derived token (like the agreement link), expiry, hashed email OTP,
// signature image, IP/UA, the kept signed PDF (pdfFile + sha256).
// status: Sent | Accepted | Declined | Expired | Replaced
model OfferVersion {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  version         Int
  status          String      @default("Sent")
  letterText      String
  offeredCtc      Float?
  offerDate       String?
  joiningDate     String?
  expiresAt       DateTime?
  tokenHash       String?     @unique
  linkCreatedAt   DateTime?
  linkStoppedAt   DateTime?
  viewedAt        DateTime?
  otpHash         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int         @default(0)
  otpSends        Int         @default(0)
  otpSentTo       String?
  otpVerifiedAt   DateTime?
  signMethod      String?
  signFile        String?
  signedName      String?
  signedAt        DateTime?
  signedIp        String?
  signedUserAgent String?
  declinedAt      DateTime?
  declineReason   String?
  expiredAt       DateTime?
  pdfFile         String?
  pdfSha256       String?
  esignProvider   String?
  esignTxnId      String?
  createdById     String?
  createdByName   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([applicationId, version])
  @@index([status, expiresAt])
}

// B4 (2026-10-06): an interview PANEL — several interviewers per round, each
// with their own scorecard. userId = a staff login; null = an external person
// (name + email typed). The overall decision stays the one Internal
// InterviewFeedback row + POST /ats/interviews/:id/decision.
model InterviewPanelist {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round          Int         @default(1)
  userId         String?
  name           String
  email          String?
  position       Int         @default(0)
  technical      Int?
  communication  Int?
  experience     Int?
  roleFit        Int?
  overall        String?
  recommendation String?
  feedbackAt     DateTime?
  feedbackById   String?
  feedbackByName String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([applicationId, round])
  @@index([userId])
}

// ONE SIGN-IN = ONE AuthSession (2026-10-09, single sign-on to the Job Portal).
// The JWT carries its id as `sid`; middleware/auth.js refuses a token whose
// session is revoked (Sign Out, the Job Portal signing out) or idle for longer
// than SESSION_IDLE_MINUTES (default 30). The Job Portal shares the same
// timer through routes/sso.js. No relation field: the table is CREATE-only,
// so the migration never rebuilds User (see README, SQLite migration rule).
model AuthSession {
  id            String    @id
  userId        String
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId])
}

model AuditLog {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  action         String
  entity         String
  entityId       String?
  fromValue      String?
  toValue        String?
  // empmgmt: the field-level approval trail —
  //   Employee · Field · Old Value · New Value · Changed By · Changed At ·
  //   Reason · Approval Status (+ who approved it and when).
  field          String?
  fieldLabel     String?
  reason         String?
  approvalStatus String? // Pending | Approved | Rejected | null (not a review)
  approvedByName String?
  approvedAt     DateTime?
  actorName      String? // snapshotted so a later rename cannot rewrite history
  createdAt      DateTime  @default(now())
}

// =============================================================================
// HRMS
// =============================================================================

// Super Admin-managed lists that populate the Department/Team dropdowns
// elsewhere in the app (e.g. adding an employee). Employee.department/team
// stay plain strings (matching the name here) rather than foreign keys, so
// existing employee records never break if a department is later renamed.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  active          Boolean          @default(true) // item 18: off = hidden from every dropdown, kept on old records
  createdAt DateTime @default(now())

  teams           Team[]
  specialisations Specialisation[]
  qualifications  Qualification[]
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  active       Boolean    @default(true) // item 18
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([departmentId, name])
}

// A POSITION IS A SEAT, AND IT OUTLIVES THE PERSON SITTING IN IT.
//
// MED-1, MED-2, Non IT-03, Edu BDE 1 — the company already staffs and
// reports by these; the source sheets are full of them. When the person in
// MED-1 resigns and somebody else takes the desk, the SEAT keeps its work
// history and the new holder starts adding to it.
model Position {
  id         String   @id @default(cuid())
  code       String   @unique // MED-1, Non IT-03, EDU BDE 1
  name       String? // "Medical Recruiter 1"
  department String?
  team       String? // "Team A" / "Team B" / "Team"
  active     Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  // THE ORGANISATION STRUCTURE — Department -> Team -> TL seat -> recruiter
  // seats. What the ATS scope engine reads (utils/positionScope.js).
  kind        String  @default("OTHER") // TL | RECRUITER | STL | OTHER
  // The seat this one reports to (recruiter -> TL seat, TL -> STL seat).
  // Plain scalar, like Requirement.tlId, so the migration is ADD COLUMN only.
  reportsToId String?

  assignments  PositionAssignment[]
  requirements Requirement[]

  @@index([department])
  @@index([reportsToId])
}

// ONE ROW PER TENURE. `toDate` null means they are sitting in it now.
//
// A column on Employee would say who holds MED-1 today and nothing else.
// The question is a HISTORY — who held it, between which dates — and that
// is a row per tenure.
model PositionAssignment {
  id         String   @id @default(cuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromDate   String // YYYY-MM-DD
  toDate     String? // null = currently holding it
  note       String?
  createdAt  DateTime @default(now())

  @@index([positionId])
  @@index([employeeId])
}

// THE SECOND LEVEL OF THE HIERARCHY: Department -> Specialisation.
//
//   Medical -> MBBS, Dermatology, Gynaecology, Paediatrics, Cardiology
//
// Candidate.specialization was already free text, which is why the same
// specialisation could be spelled three ways and never group in a report.
// This gives a department its LIST, so a requirement and a candidate pick
// from the same set and "Medical -> Dermatology -> Candidates" is a real
// filter rather than a string match that mostly works.
model Specialisation {
  id              String     @id @default(cuid())
  name            String
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  // spec_ (2026-10-03): Department -> Qualification -> Specialisation master.
  qualificationId String? // plain scalar -> Qualification.id
  isMaster        Boolean    @default(false) // true = curated master (Admin -> Specialisations); false = legacy imported value
  active          Boolean    @default(true) // deactivate instead of delete
  aliases         String? // JSON array of alternate spellings
  sortOrder       Int        @default(0)
  updatedAt       DateTime?

  @@unique([departmentId, name])
  @@index([qualificationId])
}

model Qualification {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  active       Boolean    @default(true)
  aliases      String? // JSON array, e.g. ["M.D.","Doctor of Medicine"]
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?

  @@unique([departmentId, name])
}

// spec_: back-fill review queue — suggestions only, never writes real records by itself.
model SpecialisationSuggestion {
  id               String    @id @default(cuid())
  entityType       String // REQUIREMENT | CANDIDATE
  entityId         String
  departmentId     String?
  qualificationId  String?
  specialisationId String?
  confidence       Int       @default(0) // 0-100
  reason           String?
  sourceText       String?
  status           String    @default("PENDING") // PENDING | ACCEPTED | SKIPPED
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([entityType, entityId])
  @@index([status])
  @@index([specialisationId])
}

model Employee {
  id                       String     @id @default(cuid())
  userId                   String?    @unique
  user                     User?      @relation(fields: [userId], references: [id])
  employeeCode             String     @unique
  name                     String
  email                    String?
  phone                    String?
  department               String?
  team                     String?
  // The prototype's Employee Management table has STL and TL columns. In the
  // prototype no create path ever writes them (a bug); here the Add Employee
  // form and the Assign Roles modal actually persist them.
  stl                      String?
  tl                       String?
  designation              String?
  location                 String?
  dateOfJoining            DateTime?
  employmentStatus         String     @default("Active") // Active | On Probation | Notice Period | Exit Process | Relieved | Exited
  employeeType             String?    @default("Full-time") // Full-time | Contract | Intern
  dateOfBirth              DateTime?
  gender                   String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  address                  String?
  addressType              String? // Current | Permanent
  addressLine1             String?
  addressLine2             String?
  city                     String?
  district                 String?
  state                    String?
  country                  String?
  postalCode               String?
  bloodGroup               String?
  branch                   String? // office location: Bengaluru | Chennai | Hyderabad, etc.
  shift                    String?    @default("General (9:00 AM – 6:00 PM)")
  employmentExperience     String?    @default("Fresher") // Fresher | Experienced
  educationDetails         String?
  skills                   String?
  bankName                 String?
  bankAccountNumber        String?
  ifscCode                 String?
  panNumber                String?
  // THE FULL AADHAAR NUMBER IS NOT KEPT HERE EITHER.
  //
  // This column predates the rule the client side already follows, and it is
  // empty on every one of the 290 employee records — so rather than leave a
  // trap that the first person to type into My Profile would fall into, the
  // profile form no longer writes it. Section 29 of the Aadhaar Act forbids
  // an unauthenticated entity retaining the number. What is kept is the last
  // four digits, below, and the eSign provider transaction id.
  //
  // The column stays so nothing that reads it breaks; it is written nowhere.
  aadhaarNumber            String? // deprecated — see aadhaarLast4

  // --- IDENTITY VERIFICATION, done by the employee after they sign in -----
  // Aadhaar: validated (12 digits, Verhoeff), used, and dropped. Only the
  // last four survive, with the provider reference that actually proves it.
  aadhaarLast4             String?
  aadhaarVerifiedAt        DateTime?
  aadhaarVerifyRef         String? // the eSign provider transaction id
  aadhaarVerifyNote        String? // how it was verified, said plainly
  // Mobile: the number that was actually proved, masked for display.
  mobileVerified           String?
  mobileVerifiedAt         DateTime?
  // The in-flight one-time code. Hashed, expiring, attempt-counted — the
  // same shape as the agreement OTP and the employee email OTP.
  verifyKind               String? // MOBILE | AADHAAR
  verifyTarget             String? // the digits the code was sent to
  verifyLast4              String? // Aadhaar last four, held until confirmed
  verifyOtpHash            String?
  verifyOtpExpiresAt       DateTime?
  verifyOtpAttempts        Int       @default(0)
  uanNumber                String?
  pfNumber                 String?
  esiNumber                String?
  onboardingTasks          String? // JSON array of {task, completed}
  offboardingStatus        String? // null | Serving Notice | Cleared
  offboardingTasks         String? // JSON array of {task, completed}
  pendingChanges           String? // JSON array of {field, from, to} awaiting HR approval
  // THE PROFILE STATUS VOCABULARY (empmgmt). Six unambiguous values:
  //   Profile Incomplete | Pending Review | Approved | Locked |
  //   Change Requested   | Edit Access Granted
  // Older rows carried Assigned / Pending Review / Locked and were migrated
  // in place by migrations/..._empmgmt_status_unlock_grant_field_audit.
  // routes/employees.js profileStatusOf() DERIVES the value from the
  // authoritative facts (pendingChanges / isLocked / reviewDecision /
  // unlockExpiresAt) and every transition writes it back here, so the stored
  // value and the computed one cannot drift.
  profileStage             String     @default("Profile Incomplete")
  isLocked                 Boolean    @default(false) // once HR approves the filled-in profile, the employee can no longer self-edit
  unlockRequestReason      String? // reason selected when requesting edit access on a locked profile
  unlockRequestStatus      String? // null | Pending | Approved | Rejected
  unlockRequestCount       Int        @default(0) // lifetime count, capped (see UNLOCK_REQUEST_LIMIT)
  // --- emplife: closing the review loop ----------------------------------
  // What HR decided about the LAST submitted set of pendingChanges, so the
  // employee is told the outcome instead of watching the banner disappear.
  reviewDecision           String? // null | Approved | Rejected
  reviewNote               String? // HR's reason — required on a rejection
  reviewedAt               DateTime?
  reviewedByName           String?
  // What HR decided about the last unlock request, and how long the granted
  // edit window lasts. After unlockExpiresAt the profile re-locks itself on
  // the next self-service write (routes/employees.js enforceEditWindow).
  unlockDecisionNote       String?
  unlockDecidedAt          DateTime?
  unlockExpiresAt          DateTime?
  // empmgmt: an edit-access grant is a RECORD, not just an expiry. Who
  // unlocked this profile, when, why, and which section they opened.
  unlockedById             String?
  unlockedByName           String?
  unlockedAt               DateTime?
  unlockGrantReason        String?
  unlockGrantSection       String? // "All fields" or a named section
  // Honest record of the sign-in email: whether it was really transmitted.
  credentialsSentAt        DateTime?
  credentialsSentStatus    String? // Sent | Not sent — no provider | Failed: <provider reason>
  reportingManagerId       String?
  reportingManager         Employee?  @relation("ManagerReports", fields: [reportingManagerId], references: [id])
  directReports            Employee[] @relation("ManagerReports")
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  attendance                Attendance[]
  punches                   AttendancePunch[]
  attendanceRegularizations AttendanceRegularization[]
  leaveRequests             LeaveRequest[]
  payslips                  Payslip[]
  records                   EmployeeRecord[]
  performanceReviews        PerformanceReview[]
  courseAssignments         CourseAssignment[]
  documents                 EmployeeDocument[]
  // Self check-in methods Super Admin has allowed THIS employee — comma-
  // separated from GPS | Biometric | Face. Null or empty = none: the employee
  // cannot check in by any method until Super Admin assigns one.
  checkInMethods            String?
  // User ID enrolled on the biometric device (the ADMS "PIN"). Device punches
  // carrying this PIN are recorded as this employee's attendance.
  biometricPin              String?
  projectAssignments        ProjectAssignment[]
  surveyResponses           SurveyResponse[]
  acknowledgments           Acknowledgment[]
  salaryStructure           SalaryStructure?
  // Payroll -> Accounts (migration 20260926020000_payroll_accounts_integration)
  salaryVersions            SalaryStructureVersion[]
  payrollAttendance         PayrollAttendance[]
  payrollEntries            EmployeePayrollRun[]
  fnfRequests               FnfRequest[]
  leaveBalances             LeaveBalance[]
  assetsHeld                Asset[]
  positionAssignments       PositionAssignment[]

  @@index([biometricPin])
}

// Generic table backing the smaller, similarly-shaped HRMS self-service areas
// (one Prisma model instead of ~11 near-identical ones): KT, Targets,
// Resignation, Recognition, Disciplinary, Shift Roster, Timesheet, Assets,
// Expense Claims, Helpdesk, Access Requests, Weekly Ideas.
model EmployeeRecord {
  id               String   @id @default(cuid())
  type             String // KT | TARGET | RESIGNATION | RECOGNITION | DISCIPLINARY | SHIFT | TIMESHEET | ASSET | EXPENSE | HELPDESK | ACCESS_REQUEST | WEEKLY_IDEA
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  title            String
  detail           String?
  status           String   @default("Open")
  date             String? // due date / shift date / timesheet date / expense date, as relevant
  amount           Float? // expense claim amount
  hours            Float? // timesheet hours
  category         String? // helpdesk category / expense category / asset type, as relevant
  priority         String? // helpdesk priority: Low | Medium | High | Urgent
  progressPct      Int? // 0-100, for targets/goals
  location         String? // expense claim location / travel destination
  // Helpdesk-specific columns (see backend/src/routes/helpdesk.js). Nullable with
  // defaults so every other record type is unaffected.
  assignedTo       String? // Employee.id of the agent the ticket is assigned to
  resolution       String? // resolution note, required when moving to Resolved/Closed
  resolvedAt       String? // YYYY-MM-DD the ticket was resolved/closed
  escalated        Boolean  @default(false)
  csat             Int? // 1-5 satisfaction rating, set after resolution
  notes            String? // JSON array of {author, text, internal}
  // Columns the prototype's Performance & Development screens need. All
  // nullable, so every other record type is unaffected.
  achieved         Float? // TARGET: achieved vs `amount` (the target)
  unit             String? // TARGET: the unit both figures are counted in (e.g. "hires")
  fromName         String? // KT: who ran the session · RECOGNITION: who gave the award
  toName           String? // KT: who received the handover
  raisedBy         String? // DISCIPLINARY: who logged the case
  points           Int? // RECOGNITION: award points, which drive the leaderboard
  aiNote           String? // WEEKLY_IDEA: the AI review note recorded with the decision
  // --- Knowledge Transfer -> AI Weekly Idea Contribution (type: WEEKLY_IDEA) ---
  // All nullable / defaulted, so every other record type is unaffected.
  weekStart        String? // YYYY-MM-DD, the MONDAY of the week this idea counts toward
  // How this idea was screened and scored. 'model' = the Anthropic model
  // configured in Administration -> Integrations. 'fallback' = the
  // deterministic text-similarity screen that runs when no key is configured
  // (or the call failed) — it produces NO scores, ever. The two are recorded
  // separately so a fallback result can never be mistaken for a model score.
  aiMethod         String? // 'model' | 'fallback'
  aiModel          String? // the model id, when aiMethod = 'model'
  aiDuplicate      Boolean  @default(false)
  aiDuplicateOf    String? // EmployeeRecord.id of the idea this one duplicates
  aiSimilarity     Int? // 0-100 similarity against the matched idea
  // The five named criteria. NULL means "not scored" and must render as such —
  // never as a zero.
  scoreOriginality Int?
  scoreUsefulness  Int?
  scoreImpact      Int?
  scoreClarity     Int?
  scoreFeasibility Int?
  scoreTotal       Int? // sum of the five, 5-50
  // Bill / receipt attached to the record (today: EXPENSE claims only — see
  // backend/src/utils/attachments.js). `billFile` is the name THIS SERVER
  // generated inside the upload directory; `billName` is only ever displayed,
  // never used to build a path. The bytes live outside the repository.
  billFile         String? // 32 hex chars + a whitelisted extension
  billName         String? // sanitised original filename, for display only
  billMime         String? // image/png | image/jpeg | image/webp | application/pdf
  billSize         Int? // bytes
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Named shift patterns (e.g. Morning 09:00–18:00) that employees are rostered
// into — Shift & Roster assigns an employee to one of these per date via
// EmployeeRecord(type: 'SHIFT').
model ShiftPattern {
  id        String   @id @default(cuid())
  name      String
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String // YYYY-MM-DD
  status     String // Present | Absent | Late | Half Day | Leave
  checkIn    String?
  checkOut   String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
}

// One raw device punch. Attendance (above) is the day's *marked* status; punches
// are the underlying check-in/check-out events a biometric reader, the web app or
// the mobile app records. First-in / last-out, worked hours and lateness are all
// derived from these rather than stored — see backend/src/routes/attendance.js.
model AttendancePunch {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String // YYYY-MM-DD
  time       String // HH:MM, 24-hour
  direction  String   @default("In") // In | Out
  method     String   @default("Web Check-in") // Web Check-in | Mobile App | Biometric (Fingerprint)
  location   String?
  // HRMS-24 §5 — what a web/mobile check-in captured and how it was verified.
  source             String? // Web | Mobile | Manual entry
  latitude           Float?
  longitude          Float?
  accuracyM          Float?
  locationAt         DateTime?
  locationStatus     String? // Inside geofence | No geofence configured | Not captured
  distanceM          Float?
  imageFile          String? // utils/attachments.js stored name of the live capture
  verificationStatus String? // Verified | Not applicable
  verificationScore  Float?  // 1 - median descriptor distance (higher is closer)
  livenessStatus     String? // Passed (head turn) | Passed (blink)
  userAgent          String?
  // Biometric device punches (migration 20260928120000): the state key the
  // person pressed (0 check-in, 1 check-out, 2 break-out, 3 break-in, 4 OT-in,
  // 5 OT-out), how they were verified (1 fingerprint, 15 face, 2/4 card,
  // 0/3 password) and the exact device clock time HH:MM:SS.
  deviceState        String?
  deviceVerify       String?
  clockTime          String?
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

// A request to correct a punch after the fact (missing/incorrect check-in or check-out).
model AttendanceRegularization {
  id                String    @id @default(cuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  date              String
  requestedCheckIn  String?
  requestedCheckOut String?
  reason            String?
  status            String    @default("Pending") // Pending | Approved | Rejected
  createdAt         DateTime  @default(now())
  decidedAt         DateTime?
}

model LeaveRequest {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  type           String // Sick | Casual | Earned | Unpaid
  fromDate       String
  toDate         String
  days           Float?    @default(1) // calendar days applied for — drives the balance decrement
  reason         String?
  status         String    @default("Pending") // Pending | Approved | Rejected | Cancelled
  // Captured at decision time: approvals of >= HrConfig.leaveReasonThresholdDays must
  // pick one of the configured LeaveReason labels; rejections must give free text.
  approvalReason String?
  rejectReason   String?
  decidedBy      String?
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?
}

// Per-employee, per-leave-type entitlement ledger. `total` is the entitlement for
// the current cycle (seeded from the LeaveType cap) and `taken` is incremented when
// a request is approved, so the Leave Balances report can show remaining/total.
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String // LeaveType.name
  total      Float    @default(0)
  taken      Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, type])
}

// ---------------------------------------------------------------------------
// THE APPROVAL WORKFLOW (§15/§16) — hierarchy-based approval, shared.
//
//   Employee → TL → STL → Manager → Asst Manager → Admin → Super Admin
//
// Deliberately NOT a leave table. `workflow` names which approval this is
// ('leave' today) and `recordId` is the id of the record climbing the chain,
// so the employee-request, ATS, requirement and Accounts approvals of §16 are
// the same two tables and the same engine (utils/approvalWorkflow.js) rather
// than four more copies of the same idea.
// ---------------------------------------------------------------------------

// ONE ROW PER LEVEL PER RECORD, written when the request is raised. The chain
// a request climbed is a FACT ABOUT THAT REQUEST: re-deriving it later from
// today's org structure would rewrite history every time somebody changes
// teams, so the resolved approver and the ladder position are stored.
model ApprovalStep {
  id                 String    @id @default(cuid())
  workflow           String // 'leave' | ...
  recordId           String // LeaveRequest.id, ...
  level              String // EMPLOYEE | TL | STL | MANAGER | ASSISTANT_MANAGER | ADMIN | SUPER_ADMIN
  seq                Int // 1..7 — position on the ladder
  // 'required' gates the request here; 'visibility' only shows it to them.
  // 'applicant' is the employee's own Applied row at the top.
  mode               String    @default("visibility")
  slaHours           Int? // copied from the level config, so a policy change does not re-date a live request
  // The resolved approver. Null where nobody holds the level — that step is
  // SKIPPED with a reason rather than dead-ending the chain.
  approverUserId     String?
  approverName       String?
  approverDepartment String?
  // Applied | Pending | Approved | Rejected | Waiting | Visibility | Skipped
  status             String    @default("Waiting")
  // When this step became the CURRENT owner. `pendingSince`, the elapsed
  // hours and `overdue` are COMPUTED ON READ from this plus slaHours — there
  // is no scheduler in this app and nothing ages these rows in the background.
  activatedAt        DateTime?
  dueAt              DateTime?
  actedAt            DateTime?
  actedByUserId      String?
  actedByName        String?
  note               String?
  // "Direct Super Admin Approval": a Super Admin decided this request out of
  // turn (utils/approvalWorkflow.js act()). Set on the step that carries the
  // Super Admin's decision; the steps it bypassed read "Skipped — decided
  // directly by Super Admin".
  direct             Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([workflow, recordId])
  @@index([workflow, approverUserId])
}

// "each level approval required aa / visibility-only aa separate ga define
// cheyyali" — the POLICY half. The chain above is the model; this decides
// which of its steps actually gate. Rows are created lazily from the
// workflow's defaults, so adopting a second workflow needs no backfill.
model ApprovalLevelConfig {
  id        String   @id @default(cuid())
  workflow  String
  level     String
  seq       Int
  mode      String   @default("visibility") // required | visibility
  slaHours  Int? // hours until this step is overdue; null = no due date
  active    Boolean  @default(true) // switch a level out of the chain entirely
  updatedAt DateTime @updatedAt

  @@unique([workflow, level])
}

// The resignation FORM (spec item 7), one row per EmployeeRecord of type
// RESIGNATION. Kept beside the record rather than as columns on the shared
// EmployeeRecord table; linked by recordId the same way ApprovalStep is.
// The employee-info block (ID, name, department, designation, reporting
// manager) is SNAPSHOTTED at submission so the form reads as it was filed.
model ResignationDetail {
  id                       String   @id @default(cuid())
  recordId                 String   @unique // EmployeeRecord.id (type RESIGNATION)
  employeeId               String
  employeeCode             String?
  employeeName             String?
  department               String?
  designation              String?
  reportingManager         String?
  resignationDate          String // YYYY-MM-DD
  requestedLastWorkingDate String? // YYYY-MM-DD, what the employee asked for
  approvedLastWorkingDate  String? // YYYY-MM-DD, set on final approval
  reason                   String // one of the configured reasons, or "Other"
  reasonOther              String? // free text when reason = Other
  comments                 String? // Detailed Reason / Comments
  noticePeriodDays         Int?
  handoverDetails          String?
  knowledgeTransferDetails String?
  exitComments             String?
  submittedAt              DateTime @default(now())
  submittedByUserId        String?
  submittedByName          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([employeeId])
}

// Configurable leave policy — types, caps, and the reasons offered when approving.
model LeaveType {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  cap     Int     @default(0)
  unit    String  @default("yr") // yr | month | unpaid
  carries Boolean @default(false)
  active  Boolean @default(true)
}

model LeaveReason {
  id     String  @id @default(cuid())
  label  String
  active Boolean @default(true)
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      String
  type      String?  @default("Festival") // National Holiday | Festival | Optional
  createdAt DateTime @default(now())
}

model Payslip {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  month            String // YYYY-MM
  basic            Float
  hra              Float
  allowances       Float
  deductions       Float
  netPay           Float
  // Detailed breakup, mirroring the reference app's payslip components.
  bonus            Float?   @default(0)
  specialAllowance Float?   @default(0)
  employerPf       Float?   @default(0)
  employeePf       Float?   @default(0)
  professionalTax  Float?   @default(0)
  gratuity         Float?   @default(0)
  lopDays          Float?   @default(0) // loss-of-pay days deducted this cycle
  gross            Float?   @default(0) // basic + hra + bonus + special allowance
  // Excess late arrivals beyond HrConfig.freeLateArrivalsPerMonth cost half a day's
  // pay each: lateCut = halfDayCut * round(net / 60). Deducted from netPay.
  lateCut          Float?   @default(0)
  lateDays         Float?   @default(0)
  // The month's working days and the loss-of-pay amount the run deducted
  // (gross / workingDays x lopDays), stored so the payslip prints exactly what
  // the run calculated. Days Worked = workingDays - lopDays.
  workingDays      Float?   @default(0)
  lopDeduction     Float?   @default(0)
  payMode          String?  @default("Package") // Package | Stipend
  generatedAt      DateTime @default(now())
  // Payroll -> Accounts: the extra deduction lines, and the EmployeePayrollRun
  // this payslip was generated from (null for payslips from the old month run).
  esiEmployee      Float?   @default(0)
  esiEmployer      Float?   @default(0)
  tds              Float?   @default(0)
  otherDeductions  Float?   @default(0)
  payrollEntryId   String?
  incentive        Float?   @default(0) // Recruiter joinings incentive line (in gross)
  conveyance       Float?   @default(0) // Payroll import: Conveyance line
  arrears          Float?   @default(0) // Payroll import: Arrears line
  importedBreakup  String? // Payroll import: JSON of every sheet cell

  @@unique([employeeId, month])
}

// One payroll cycle. Created as "Processing" by POST /api/payroll/run and moved to
// "Paid" by PATCH /api/payroll/runs/:id/paid, giving the Payroll history and the
// month-over-month comparison on the Reports tab something to read.
model PayrollRun {
  id              String    @id @default(cuid())
  month           String    @unique // YYYY-MM
  period          String // "September 2026"
  department      String? // null = every department
  status          String    @default("Processing") // Processing | Paid
  employees       Int       @default(0)
  totalGross      Float     @default(0)
  totalDeductions Float     @default(0)
  totalLateCuts   Float     @default(0)
  totalNet        Float     @default(0)
  processedBy     String?
  processedAt     DateTime  @default(now())
  paidAt          DateTime?
  // The per-employee records of this month (SPEC B). A run created before
  // them (e.g. August 2026) has none and keeps its own Processing/Paid status.
  // With entries, `status` is derived from them: Draft | Pending Approval |
  // Approved | Synced | Paid (the least-advanced entry wins).
  entries         EmployeePayrollRun[]
}

// One employee's pay structure — either a flat Stipend, or a Package broken
// into Basic/HRA/Bonus/Special Allowance with PF/PT deductions and employer
// costs, matching the reference app's CTC breakup.
model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  employee         Employee @relation(fields: [employeeId], references: [id])
  payMode          String   @default("Package") // Package | Stipend
  ctc              Float    @default(0)
  stipend          Float    @default(0)
  basic            Float    @default(0)
  hra              Float    @default(0)
  bonus            Float    @default(0)
  specialAllowance Float    @default(0)
  conveyance       Float    @default(0) // mirror of the current version
  employerPf       Float    @default(0)
  employeePf       Float    @default(0)
  professionalTax  Float    @default(0)
  gratuity         Float    @default(0)
  updatedAt        DateTime @updatedAt
  // VERSIONED (SPEC B §2). This row is the CURRENT version — a mirror of the
  // employee's latest SalaryStructureVersion — so every existing reader of
  // employee.salaryStructure keeps working. Payroll for a month reads the
  // version effective in that month (SalaryStructureVersion), never this row.
  effectiveFrom    String? // YYYY-MM-DD (always the 1st of a month)
  effectiveTo      String? // null = open-ended
  esiApplicable    Boolean? // null = automatic (gross <= HrConfig.esiGrossCeiling)
  esiEmployee      Float    @default(0)
  esiEmployer      Float    @default(0)
  tds              Float? // monthly TDS; null = HrConfig.tdsDefaultPctOfGross
  otherDeductions  Float    @default(0)
  currentVersionId String?
}

// Every version of an employee's salary structure. A version pays from the
// 1st of its effectiveFrom month until the day before the next version's
// effectiveFrom (effectiveTo, kept in step by utils/salaryVersions.js). A
// revision can never take effect on a month whose payroll is already beyond
// DRAFT, so past runs are never recomputed from a later revision.
model SalaryStructureVersion {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom    String // YYYY-MM-DD, the 1st of a month
  effectiveTo      String? // YYYY-MM-DD, last day it applies; null = current
  payMode          String   @default("Package") // Package | Stipend
  ctc              Float    @default(0) // ANNUAL, like SalaryStructure.ctc
  stipend          Float    @default(0)
  basic            Float    @default(0)
  hra              Float    @default(0)
  bonus            Float    @default(0)
  specialAllowance Float    @default(0)
  conveyance       Float    @default(0) // Payroll import (2026-10-06): the registers' Conveyance earning
  employerPf       Float    @default(0)
  employeePf       Float    @default(0)
  professionalTax  Float    @default(0)
  gratuity         Float    @default(0)
  esiApplicable    Boolean?
  esiEmployee      Float    @default(0)
  esiEmployer      Float    @default(0)
  tds              Float?
  otherDeductions  Float    @default(0)
  note             String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([employeeId, effectiveFrom])
}

// HR's monthly attendance input override for one employee (SPEC B §3). The
// DEFAULT is computed live from the attendance module (utils/attendanceDays.js)
// and never stored; a row here means HR overrode it, and every override also
// writes an AuditLog row (entity PayrollAttendance).
model PayrollAttendance {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month            String // YYYY-MM
  year             Int
  monthNum         Int
  workingDays      Float     @default(0)
  daysPresent      Float     @default(0)
  daysLop          Float     @default(0)
  autoDaysPresent  Float?
  autoDaysLop      Float?
  reason           String?
  overriddenBy     String?
  overriddenByName String?
  overriddenAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([employeeId, month])
}

// ONE PAYROLL RECORD PER EMPLOYEE PER MONTH (SPEC B §4/§5) — the spec's
// payroll_run. Status: DRAFT -> PENDING_APPROVAL -> APPROVED ->
// SYNCED_TO_ACCOUNTS -> PAID, enforced by utils/payrollEngine.js. Amounts are
// a snapshot: recalculation only ever touches a DRAFT.
model EmployeePayrollRun {
  id                    String      @id @default(cuid())
  employeeId            String
  employee              Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRunId          String?
  payrollRun            PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  month                 String // YYYY-MM
  year                  Int
  monthNum              Int
  salaryVersionId       String?
  payMode               String      @default("Package")
  workingDays           Float       @default(0)
  daysPresent           Float       @default(0)
  daysLop               Float       @default(0)
  attendanceSource      String      @default("ATTENDANCE") // ATTENDANCE | OVERRIDE
  basic                 Float       @default(0)
  hra                   Float       @default(0)
  bonus                 Float       @default(0)
  specialAllowance      Float       @default(0)
  grossPay              Float       @default(0) // full-month gross earnings
  lopDeduction          Float       @default(0)
  earnedGross           Float       @default(0) // grossPay - lopDeduction
  pfEmployee            Float       @default(0)
  esiEmployee           Float       @default(0)
  professionalTax       Float       @default(0)
  tds                   Float       @default(0)
  otherDeductions       Float       @default(0)
  totalDeductions       Float       @default(0) // PF + ESI + PT + TDS + LOP + other
  netPay                Float       @default(0) // grossPay - totalDeductions
  pfEmployer            Float       @default(0)
  esiEmployer           Float       @default(0)
  gratuity              Float       @default(0) // informational, not booked
  // Recruiter joinings (2026-10-05): Super Admin's incentive for the previous
  // month's joinings, a separate earning line. 0 = none.
  incentive             Float       @default(0)
  // Payroll import (2026-10-06): the registers' Conveyance (an earning in the
  // structure) and one-off Arrears, the full imported breakup (JSON of every
  // sheet cell) and the import note. 0 / null on entries the app computed.
  conveyance            Float       @default(0)
  arrears               Float       @default(0)
  importedBreakup       String?
  importNote            String?
  status                String      @default("DRAFT")
  payslipId             String?
  calculatedBy          String?
  calculatedAt          DateTime?
  submittedBy           String?
  submittedAt           DateTime?
  approvedBy            String?
  approvedAt            DateTime?
  syncedAt              DateTime?
  journalEntryId        String?
  paidBy                String?
  paidAt                DateTime?
  paymentJournalEntryId String?
  bankTransactionId     String?
  paymentReference      String?
  rejectionReason       String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([employeeId, month])
  @@index([month, status])
}

// HRMS -> Accounts delivery log (SPEC B §6). One row per idempotency key:
// ACCRUAL = "payroll-run:<id>" (the salary journal), PAYMENT =
// "payroll-payment:<id>" (the bank payment journal). Retried by hand and by
// the sweep in utils/payrollSync.js.
model PayrollSyncLog {
  id                   String    @id @default(cuid())
  kind                 String    @default("ACCRUAL") // ACCRUAL | PAYMENT
  employeePayrollRunId String
  employeeId           String?
  month                String?
  idempotencyKey       String    @unique
  status               String    @default("PENDING") // PENDING | SUCCESS | FAILED
  attempts             Int       @default(0)
  lastError            String?
  lastAttemptAt        DateTime?
  nextAttemptAt        DateTime?
  payload              String? // JSON, exactly what is POSTed
  journalEntryId       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

// Full & Final settlement request, raised when an employee's offboarding completes.
model FnfRequest {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  lastWorkingDate  String
  status           String    @default("Pending") // Pending | Processed
  settlementAmount Float?
  createdAt        DateTime  @default(now())
  processedAt      DateTime?
}

// =============================================================================
// ACCOUNTS
// =============================================================================

model Invoice {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  candidateId   String?
  candidate     Candidate?   @relation(fields: [candidateId], references: [id])
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])
  amount        Float
  gst           Float        @default(0)
  tds           Float        @default(0)
  status        String       @default("Pending") // Pending | Partially Paid | Paid | Overdue | Cancelled
  invoiceDate   String
  dueDate       String?
  paymentTerms  String?      @default("Invoice 6 days after joining; payment due within 6 days of invoice")
  // Commercial trail for an invoice raised from ATS on candidate joining.
  feePercent    Float?
  offeredCtc    Float?
  joiningDate   String?
  createdAt     DateTime     @default(now())

  // Accounts depth — human-facing number, money actually received, and the
  // bank line that finally closed the invoice off.
  invoiceNumber  String? @unique
  receivedAmount Float   @default(0)
  paidDate       String?
  bankTxnId      String?
  notes          String?

  // Invoice register depth — the prototype's "Sent" and "TDS certificate"
  // columns, and the GST / TDS rate actually applied to this one invoice
  // (a client's standing rate can be overridden per deal).
  sentVia         String?
  sentDate        String?
  tdsCertReceived Boolean @default(false)
  tdsCertRef      String?
  tdsCertDate     String?
  gstPercent      Float?
  tdsPercent      Float?
  gstType         String? // CGST_SGST | IGST | NONE
  tdsBase         String? // base | gross — what the TDS % was applied to
  tdsSection      String? // e.g. 194J
  tdsDeductedOn   String? // YYYY-MM-DD
  // The Form 16A file itself (utils/attachments.js stored name), when uploaded.
  tdsCertFile     String?
  tdsCertName     String?
  tdsCertMime     String?

  // S8 Accounts Dashboard — the proof behind a receipt recorded on the invoice itself (imports carry no InvoicePayment rows).
  proofFile       String?
  proofName       String?
  proofMime       String?
  proofRef        String?
  proofAt         String?
  proofBy         String?
  payments InvoicePayment[]
  // B2 — credit / debit notes. creditedAmount = issued credit notes set against this invoice's balance (rest = CreditNote.refundDue); debitedAmount = issued debit notes. Both 0 on existing invoices.
  creditedAmount Float @default(0)
  debitedAmount  Float @default(0)
  creditNotes    CreditNote[]
}

// A receipt against an invoice. An invoice can be settled by several of these,
// which is what makes "Partially Paid" a real state rather than a label.
model InvoicePayment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date       String
  amount     Float
  method     String   @default("Bank Transfer")
  reference  String?
  notes      String?
  bankTxnId  String?
  recordedBy String?
  createdAt  DateTime @default(now())
  // A hand-recorded receipt a bank line was later linked to as proof — undoing
  // the link clears bankTxnId but never deletes or reverses the receipt.
  bankLinked Boolean  @default(false)
}

// B2 — a credit note (kind "credit": replacement / refund / wrong amount / left within the guarantee) or a debit note (kind "debit": an extra charge) against ONE client invoice. Same GST type / rates and TDS base as the invoice. Number CN-YYYY-#### / DN-YYYY-#### given on issue. Draft -> Issued (maker-checker) -> Cancelled.
model CreditNote {
  id              String    @id @default(cuid())
  kind            String    @default("credit") // credit | debit
  number          String?   @unique
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  clientId        String
  applicationId   String?
  noteDate        String
  reason          String
  reasonText      String?
  amount          Float
  gstType         String    @default("NONE")
  gstPercent      Float     @default(0)
  cgst            Float     @default(0)
  sgst            Float     @default(0)
  igst            Float     @default(0)
  gst             Float     @default(0)
  tdsPercent      Float     @default(0)
  tdsBase         String    @default("base")
  tds             Float     @default(0)
  net             Float
  applied         Float     @default(0)
  refundDue       Float     @default(0)
  refundPaidOn    String?
  refundRef       String?
  refundPaidBy    String?
  status          String    @default("Draft") // Draft | Issued | Cancelled
  createdById     String?
  createdByName   String?
  approvedById    String?
  approvedByName  String?
  issuedAt        DateTime?
  cancelledAt     DateTime?
  cancelledByName String?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([applicationId])
}

model BankTransaction {
  id               String   @id @default(cuid())
  date             String
  description      String
  type             String // Credit | Debit
  amount           Float
  matched          Boolean  @default(false)
  matchedInvoiceId String?
  createdAt        DateTime @default(now())

  // Reconciliation state machine:
  // Unmatched -> Matched -> Reconciled, with Ignored as a parked side state.
  reconStatus   String  @default("Unmatched")
  reference     String?
  balance       Float?
  matchedBy     String?
  matchedDate   String?
  clientName    String?
  importBatch   String?
  ignoredReason String?

  // Bank & Reconciliation depth, from the accounting application.
  // A statement line belongs to one bank account; "excluded" keeps a line on
  // file but out of the uncategorised count; the category fields are what the
  // categorisation panel filed a debit (or a non-invoice credit) as.
  bankAccountId String?
  excluded      Boolean @default(false)
  category      String?
  categoryKind  String? // expense | hand | transfer | other
  vendor        String?
  counterparty  String?
  excess        Float? // part of a credit that was more than the client owed
  importFile    String?
  // Match / Categorise panel: the office bill it created from this line, and
  // the existing bills it settled (JSON [{id, approvalStatus, paidStatus}]).
  createdBillId String?
  billLinks     String?

  @@index([bankAccountId, date])
  @@index([bankAccountId])
}

// Hand loans (Bank & Reconciliation). Money borrowed from a person; the bank
// lines that prove the taking (a credit) and each repayment (a debit) are
// HandLoanLink rows — one statement line can back one loan line only.
model HandLoan {
  id          String         @id @default(cuid())
  name        String
  lender      String?
  amount      Float
  dateTaken   String
  notes       String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  links       HandLoanLink[]
}

model HandLoanLink {
  id          String   @id @default(cuid())
  loanId      String
  loan        HandLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  bankTxnId   String   @unique
  kind        String // taken | repayment
  date        String
  amount      Float
  reference   String?
  description String?
  auto        Boolean  @default(false)
  linkedBy    String?
  createdAt   DateTime @default(now())

  @@index([loanId])
}

// A bank account or credit card. Each one keeps its own statement, its own
// opening balance and its own running balance.
model BankAccount {
  id        String   @id @default(cuid())
  bank      String
  name      String?
  accNo     String?
  ifsc      String?
  branch    String?
  openBal   Float    @default(0)
  openDate  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// A narration rule the app learnt: "Save & remember this narration".
model BankRule {
  id        String   @id @default(cuid())
  match     String
  category  String
  vendor    String?
  gstRate   Float?
  kind      String   @default("expense") // expense | hand | transfer
  createdAt DateTime @default(now())
}

// The balance log: what the bank actually showed on a date, typed in by hand.
model BankMark {
  id            String   @id @default(cuid())
  bankAccountId String?
  date          String
  kind          String   @default("Bank balance on that date")
  balance       Float?
  cleared       Float?
  match         String?
  note          String?
  recordedBy    String?
  createdAt     DateTime @default(now())
}

// Every statement that has ever been imported, with its file and its period.
model BankImport {
  id            String   @id @default(cuid())
  bankAccountId String?
  date          String
  file          String?
  recordedBy    String?
  lines         Int      @default(0)
  skipped       Int      @default(0)
  credits       Float    @default(0)
  debits        Float    @default(0)
  fromDate      String?
  toDate        String?
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// THE LEDGER (Accounts module, SPEC B §7). A minimal chart of accounts and a
// double-entry journal. HRMS payroll books into it ONLY through
// POST /api/accounts/journal-entries (routes/journal.js), with an
// idempotencyKey per payroll record so a retry can never double-book.
// ---------------------------------------------------------------------------
model LedgerAccount {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String        @unique
  type        String // ASSET | LIABILITY | EXPENSE | INCOME | EQUITY
  aliases     String? // other names a payload may use, comma-separated
  description String?
  isActive    Boolean       @default(true)
  isSystem    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  lines       JournalLine[]
}

model JournalEntry {
  id             String        @id @default(cuid())
  date           String // YYYY-MM-DD
  month          String // YYYY-MM (the payroll month for payroll entries)
  narration      String?
  source         String        @default("MANUAL") // HRMS_PAYROLL | MANUAL
  referenceType  String? // PAYROLL_RUN | PAYROLL_PAYMENT
  referenceId    String? // EmployeePayrollRun.id
  idempotencyKey String        @unique
  employeeId     String?
  employeeName   String?
  totalDebit     Float         @default(0)
  totalCredit    Float         @default(0)
  payload        String? // the payload as received
  createdBy      String?
  createdByName  String?
  createdAt      DateTime      @default(now())
  lines          JournalLine[]

  @@index([month])
  @@index([referenceType, referenceId])
}

model JournalLine {
  id             String        @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  lineNo         Int           @default(0)
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  accountCode    String
  accountName    String
  debit          Float         @default(0)
  credit         Float         @default(0)
  referenceType  String?
  referenceId    String?
  memo           String?
  createdAt      DateTime      @default(now())

  @@index([journalEntryId])
  @@index([accountCode])
}

model OfficeExpense {
  id            String   @id @default(cuid())
  category      String
  location      String?
  monthlyAmount Float
  createdAt     DateTime @default(now())

  // Office & Business depth — a dated, vendor-attributed bill with its own GST,
  // which is what the month summary, the P&L and the GST position are built on.
  vendor      String?
  expenseDate String?
  gstAmount   Float   @default(0)
  paidStatus  String  @default("Paid") // Paid | Unpaid
  recurring   Boolean @default(true)
  notes       String?

  // Office & Business depth — TDS the office deducted from the vendor, the
  // amortisation window behind "Amortised" in the month summary, and the
  // vendor GSTIN without which the input credit cannot be claimed.
  tdsAmount     Float   @default(0)
  frequency     String? @default("Monthly")
  monthsCovered Int?
  vendorGstin   String?
  paymentMode   String? @default("Bank Transfer")
  description   String?
  // The vendor's own invoice number — what a GST return is reconciled against.
  billNumber    String?

  // Office & Accounts depth — the reference accounting app's expense record.
  // A bill can be an expense or an owner's hand loan (a loan is not a cost, so
  // it stays out of profit and GST); a pending bill carries its own due date,
  // which is where the calendar shows it and what makes it overdue.
  entryKind    String? @default("expense") // expense | hand
  dueDate      String?
  remarks      String?
  approvedBy   String?
  // The rate actually applied to THIS bill. GST and TDS money is stored as an
  // amount, but the rate is what the GST vendor table reports, so it is kept
  // rather than inferred — never assumed to be 18%.
  gstRatePct   Float?
  tdsRatePct   Float?
  // Type of supply and the place it was supplied from — CGST+SGST within the
  // state, IGST across states.
  supplyType   String? // Goods | Service
  gstTreatment String?
  sourceState  String?
  // Proof of payment. The file itself is NOT stored here — see the route file:
  // this is the metadata a real object store would key off.
  proofName    String?
  proofMime    String?
  proofSize    Int?
  proofAt      String?
  proofBy      String?
  // The stored upload behind proofName (utils/attachments.js — a random name
  // inside UPLOAD_DIR, never a client path). Null when only a name was typed.
  proofFile    String?
  // The imported bank statement line this payment came off. That line is the
  // proof of payment on its own; only input GST still needs the vendor's own
  // tax invoice.
  bankTxnId    String?

  // Edit-expense form — the rest of the accounting application's expense
  // record. All nullable; a row without them reads exactly as before.
  //   expenseAccount  the ledger the bill is booked to (Category is the
  //                   grouping the register and the filters use)
  //   hsnSac          HSN for goods, SAC for services — GSTR-2B lists it
  //   destState       place of supply (sourceState above is where it came from)
  //   reverseCharge   GST paid by us under RCM rather than charged by the vendor
  //   billableClient  the client this cost is to be recharged to, by name
  //   reportingTags   comma-separated free tags for reports
  expenseAccount String?
  hsnSac         String?
  destState      String?
  reverseCharge  Boolean?
  billableClient String?
  reportingTags  String?

  // APPROVAL LIFECYCLE (Office & Expenses spec A). PENDING -> APPROVED -> PAID,
  // or PENDING -> REJECTED with a reason. paidStatus above stays the PAYMENT
  // status and is kept in step: PAID <=> paidStatus "Paid". Editing is allowed
  // only while PENDING (routes/office.js). approvedBy (text) is still written
  // with the approver's name; the ids and times below are the record.
  approvalStatus  String    @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  rejectionReason String?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  paidById        String?
  paidAt          DateTime?
  updatedAt       DateTime? @updatedAt

  // Office & Accounts one-page (2026-09-26). expenseCode is the human Expense
  // ID (EXP-0001, sequential; existing rows backfilled in date order by the
  // migration). updatedById is "Modified By" (updatedAt above is "Modified
  // At"). REIMBURSED is an extra final approvalStatus — a bill someone paid
  // out of pocket and the office has since paid back — reached from APPROVED
  // or PAID by an approver; these two columns record who and when.
  expenseCode     String?   @unique
  updatedById     String?
  reimbursedById  String?
  reimbursedAt    DateTime?

  @@index([approvalStatus])
  @@index([expenseDate])
}

// The Office & Expenses category list. Preloaded with the eight defaults and
// every category already used on an expense, so no expense is orphaned. Only
// the Accounts Admin / Approver adds or retires one.
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// HRMS — long tail
// =============================================================================

model PerformanceReview {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  period         String // e.g. "2026-H1"
  score          Int // 0-100
  band           String // High | Medium | Low
  recommendation String // Recommended | Not Recommended
  notes          String?
  // §13 — A RECOMMENDATION IS NOT AN AWARD. `recommendation` above is the
  // TL's opinion; this is whether the chain has agreed with it. Approved by
  // default so every review that already exists reads exactly as it did.
  approvalStatus String   @default("Approved") // Approved | Pending | Rejected
  // Who recommended — the applicant on the chain, and the one person who may
  // not approve it. Null on rows raised before the chain shipped.
  raisedById     String?
  createdAt      DateTime @default(now())
}

model Course {
  id             String   @id @default(cuid())
  title          String
  category       String? // Onboarding | ATS | Compliance | Soft Skills
  duration       String?
  // LMS screen columns. `mandatory` drives the Mandatory tag on a course row;
  // `passMark` is the percentage a learner must score to certify. Both are
  // plain ADD COLUMNs (migration 20260921170000_lms_course_and_expense_bill).
  mandatory      Boolean  @default(false)
  passMark       Int      @default(70)
  // §14 — A COURSE IS A DRAFT UNTIL THE CHAIN APPROVES PUBLICATION. A TL may
  // propose training; putting it in front of the company is not theirs alone.
  // Approved by default so every existing course stays published.
  approvalStatus String   @default("Approved") // Approved | Pending | Rejected
  raisedById     String?
  createdAt      DateTime @default(now())

  assignments CourseAssignment[]
  materials   CourseMaterial[]
  questions   AssessmentQuestion[]

  // COMPLETION RULES — what a learner must do before the course completes on
  // its own (there is no manual "Mark as completed").
  requireVideos     Boolean @default(true)
  requireDocuments  Boolean @default(true)
  requireAssessment Boolean @default(true)
  // Who the course was assigned to, as chosen: Everyone | Departments |
  // Individuals, and the departments picked (comma-separated). The per-person
  // CourseAssignment rows are what actually give access.
  assignMode        String?
  assignDepartments String?
  // ASSESSMENT RULES (HRMS-24 §14). questionsPerAttempt: how many questions
  // each attempt draws from the bank (null = all). timeLimitMinutes: null =
  // untimed. maxAttempts: null = unlimited. Migration
  // 20260925233000_hrms24_lms_assessment_rules_audit.
  questionsPerAttempt Int?
  timeLimitMinutes    Int?
  maxAttempts         Int?
  randomizeQuestions  Boolean @default(true)
}

// HRMS-24 §22 — ONE ROW PER "ASSIGN" ACTION: who assigned the course, to
// what audience (Everyone / departments / individuals), when, with what due
// date and how many people it reached. The per-person CourseAssignment rows it
// created carry its id in `batchId`.
model CourseAssignmentBatch {
  id             String    @id @default(cuid())
  courseId       String
  mode           String // Everyone | Departments | Individuals
  departments    String? // comma-separated
  employeeIds    String? // JSON array
  label          String?
  assignedById   String?
  assignedByName String?
  assignedByRole String?
  // Assigned by an organisation-wide login — the only kind whose Everyone /
  // department assignment also reaches people who join later.
  orgWide        Boolean   @default(false)
  dueDate        DateTime?
  assignedCount  Int       @default(0)
  alreadyCount   Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([courseId])
}

// HRMS-24 §14 — one assessment attempt: the questions drawn for it, its
// clock, and its result. correct answers stay in AssessmentQuestion.
model CourseAssessmentAttempt {
  id           String    @id @default(cuid())
  assignmentId String
  courseId     String
  employeeId   String
  attemptNo    Int
  questionIds  String // JSON array — the paper drawn for this attempt
  startedAt    DateTime  @default(now())
  expiresAt    DateTime?
  submittedAt  DateTime?
  score        Int?
  correct      Int?
  total        Int       @default(0)
  passed       Boolean?
  timedOut     Boolean   @default(false)

  @@index([assignmentId])
  @@index([courseId, employeeId])
}

model CourseAssignment {
  id             String    @id @default(cuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id])
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  completed      Boolean   @default(false)
  // When the learner finished — what the Certifications screen dates a
  // certificate by. Null for an enrollment still in progress.
  completedAt    DateTime?
  // Per-enrolment progress. "Video watch time: Not started" on the Enrolled
  // Employees panel reads watchedSeconds; the score columns hold the last
  // assessment attempt. Plain ADD COLUMNs — migration
  // 20260922160000_lms_materials_assessment.
  watchedSeconds Int       @default(0)
  score          Int?
  scoredAt       DateTime?
  attempts       Int       @default(0)
  assignedAt     DateTime  @default(now())
  // When every required material was finished — the moment the assessment opens.
  contentCompletedAt  DateTime?
  // Issued when the course completes; the ID printed on the certificate.
  certificateId       String?   @unique
  certificateIssuedAt DateTime?
  // HRMS-24 §14 / §22 — the assignment audit and the completion record.
  assignedById          String?
  assignedByName        String?
  source                String? // Individual | Department | Everyone | Self | Auto
  department            String? // the employee's department when assigned
  batchId               String?
  dueDate               DateTime?
  startedAt             DateTime? // first time the learner opened anything
  lastAccessedAt        DateTime?
  assessmentStartedAt   DateTime?
  assessmentCompletedAt DateTime? // last submitted attempt
  passedAttempt         Int?
  certificateEligible   Boolean   @default(false)
  extraAttempts         Int       @default(0) // granted by an assigner after the limit

  @@unique([courseId, employeeId])
}

// A file or link attached to a course. `storedPath` is where an upload landed;
// `url` is used instead when the material is a link, so both kinds sit in one
// list on the Course Materials panel.
model CourseMaterial {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  fileName   String?
  storedPath String?
  mimeType   String?
  sizeBytes  Int?
  url        String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  // Video | Document | Link — how the learner's player shows it.
  kind            String?
  // Length of a video, recorded the first time a player loads it.
  durationSeconds Int?
  // Counts toward completion unless marked optional.
  required        Boolean @default(true)

  progress CourseMaterialProgress[]

  @@index([courseId])
}

// One learner's progress on one course material: seconds actually watched
// (not just the furthest point reached), where to resume, and whether it is done.
model CourseMaterialProgress {
  id              String         @id @default(cuid())
  materialId      String
  material        CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  courseId        String
  employeeId      String
  secondsWatched  Int            @default(0)
  lastPosition    Int            @default(0)
  durationSeconds Int?
  completed       Boolean        @default(false)
  completedAt     DateTime?
  updatedAt       DateTime       @updatedAt
  // HRMS-24 §14 — when the material was first opened, and for a PDF how many
  // of its pages have been on screen (it completes once every page has).
  firstViewedAt   DateTime?
  pagesViewed     Int            @default(0)
  pageCount       Int?

  @@unique([materialId, employeeId])
  @@index([courseId, employeeId])
}

// One multiple-choice question in a course's question bank.
//
// correctIndex IS THE ANSWER AND IT NEVER LEAVES THE SERVER on a learner
// request — the assessment endpoint strips it for whoever is taking the test
// and returns it only to someone who may manage the course. Questions are
// shuffled per attempt for the same reason.
model AssessmentQuestion {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  question     String
  options      String // JSON array of option strings
  correctIndex Int
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([courseId])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("Active") // Active | Completed | On Hold
  createdAt DateTime @default(now())

  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       String?
  assignedAt DateTime @default(now())

  @@unique([projectId, employeeId])
}

model Survey {
  id          String   @id @default(cuid())
  title       String
  status      String   @default("Active") // Active | Closed
  questions   String // JSON-encoded array of question strings
  // Which departments this survey was published to. NULL / empty = every
  // department, which is what every survey created before this column meant.
  // Comma-separated names, the same shape User.atsScopeDepartments uses.
  departments String?
  // AUDIENCE (utils/audience.js). Individually picked Employee.ids, JSON
  // array. NULL = not individually targeted — the departments column above
  // (or nothing = everybody) decides, exactly as before.
  employeeIds String?
  createdById String? // User.id of whoever published it
  createdAt   DateTime @default(now())

  responses SurveyResponse[]
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  answers     String // JSON-encoded array of answer strings
  submittedAt DateTime @default(now())

  @@unique([surveyId, employeeId])
}

model PolicyDocument {
  id           String   @id @default(cuid())
  title        String
  category     String? // Policy | Compliance
  mandatory    Boolean  @default(false)
  published    Boolean  @default(true)
  target       String?  @default("All Employees")
  // AUDIENCE (utils/audience.js). Comma-separated department names and a
  // JSON array of Employee.ids. Both NULL = every employee, which is what
  // every document created before these columns meant.
  departments  String?
  employeeIds  String?
  createdById  String?
  uploadedBy   String?
  uploadedDate String
  createdAt    DateTime @default(now())

  acknowledgments Acknowledgment[]
}

model Acknowledgment {
  id             String         @id @default(cuid())
  documentId     String
  document       PolicyDocument @relation(fields: [documentId], references: [id])
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  acknowledgedAt DateTime       @default(now())

  @@unique([documentId, employeeId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String? // Holiday | Policy | General | Event
  pinned    Boolean  @default(false)
  target    String?  @default("All Employees")
  // AUDIENCE (utils/audience.js). `target` stays the human label; these two
  // are what visibility is decided on. Both NULL = a row written before they
  // existed, which keeps the old free-text `target` rule.
  departments String? // comma-separated department names
  employeeIds String? // JSON array of Employee.ids
  delivery    String? // JSON: what each "Also deliver via" channel did
  postedById  String? // User.id of whoever posted it
  postedBy  String?
  date      String
  createdAt DateTime @default(now())
}

model HrConfig {
  id                           String  @id @default(cuid())
  freeLateArrivalsPerMonth     Int     @default(2)
  freeEarlyLogoutsPerMonth     Int     @default(1)
  earliestExcusableEarlyLogout String  @default("17:00")
  // Attendance policy
  graceTimeMinutes             Int     @default(15)
  // Clock time (HH:MM, 24h) after which a check-in punch counts as late. This is
  // what the punch log and the monthly report actually compare against;
  // graceTimeMinutes above stays for the older minutes-after-shift-start reading.
  graceTime                    String  @default("09:30")
  halfDayHours                 Float   @default(4)
  fullDayHours                 Float   @default(8)
  // Calendar days of notice an employee serves after resigning.
  noticePeriodDays             Int     @default(45)
  // Resignation form (routes/resignations.js). Reasons offered in the Reason
  // select (JSON array of strings; null = the built-in list) and which of the
  // optional fields the form shows (JSON array of keys: noticePeriod,
  // handover, knowledgeTransfer, exitComments; null = all of them).
  resignationReasons           String?
  resignationOptionalFields    String?
  // Payroll policy — how attendance turns into pay
  unmarkedDaysUnpaid           Boolean @default(true)
  weekendsPaid                 Boolean @default(true)
  paidLeaveDaysPerMonth        Int     @default(1)
  // CTC split settings — how every employee's CTC is broken into components.
  // Special Allowance always absorbs whatever's left over so the pieces
  // reconcile exactly back to CTC.
  basicPctOfCtc                Float   @default(50)
  hraPctOfBasic                Float   @default(40)
  bonusPctOfBasic              Float   @default(8.33)
  employeePfPctOfBasic         Float   @default(12)
  employerPfPctOfBasic         Float   @default(12)
  employeePfMonthlyCap         Float   @default(1800)
  employerPfMonthlyCap         Float   @default(1800)
  gratuityPctOfBasic           Float   @default(4.81)
  professionalTaxFlat          Float   @default(200)
  // Standard Package (utils/salaryRules.js): Bonus is a FIXED monthly amount,
  // not a % of Basic — bonusPctOfBasic and professionalTaxFlat are no longer
  // read (PT is the Telangana slab in utils/salaryRules.js). basicPctOfCtc is
  // 40 on live data (migration 20260925160000); its column default stays 50
  // only because changing a SQLite default needs a table rebuild.
  bonusFixedMonthly            Float   @default(1000)
  // Leave policy — concurrent leave caps
  concurrentLeaveCapPct        Int     @default(30)
  concurrentLeaveCapFlat       Int     @default(2)
  leaveReasonThresholdDays     Int     @default(4)
  // Payroll policy — the rest of the prototype's "How attendance affects pay"
  // switches. Its "minimum hours for a full/half day" read the fullDayHours /
  // halfDayHours above, which are the same numbers.
  payByHours                   Boolean @default(false)
  halfDayBySession             Boolean @default(false)
  sessionSplit                 String  @default("13:00")
  // Approval escalation order (comma-separated roles) — a leave, attendance
  // regularization or issue request climbs this chain top to bottom.
  escalationOrder              String  @default("Recruiter,TL,Manager,Admin,Super Admin")
  // HRMS-24 §4 — how a past working day with NO check-in reads: "Absent" or
  // "Missing Check-In". Weekly offs are day numbers (0 = Sunday … 6 = Saturday).
  missingCheckInRule           String  @default("Missing Check-In")
  weeklyOffDays                String  @default("0,6")
  // HRMS-24 §5 — web/mobile check-in geofence (Super Admin) and the face-match
  // threshold (euclidean distance between face descriptors; lower is stricter).
  geofenceEnabled              Boolean @default(false)
  officeLatitude               Float?
  officeLongitude              Float?
  geofenceRadiusM              Int     @default(200)
  faceMatchThreshold           Float   @default(0.45)
  // Payroll statutory settings (SPEC B). ESI applies only while the monthly
  // gross is at or under the ceiling; contributions are on the earned gross,
  // rounded UP to the rupee. TDS: a version's own monthly figure wins, else
  // this % of earned gross (0 = no TDS unless entered on the structure).
  esiEnabled                   Boolean @default(true)
  esiEmployeePct               Float   @default(0.75)
  esiEmployerPct               Float   @default(3.25)
  esiGrossCeiling              Float   @default(21000)
  tdsDefaultPctOfGross         Float   @default(0)
}

// =============================================================================
// ADMINISTRATION
// =============================================================================

model Company {
  id       String  @id @default(cuid())
  name     String
  email    String?
  phone    String?
  address  String?
  // Company Setup (prototype companySetupView, line 9693) also carries the
  // headquarters line and the list of employment policies.
  hq       String?
  policies String? // JSON array of policy names, each shown with an Active chip

  // Everything the printable tax invoice prints in its letterhead, its "Place
  // of Supply" line and its payment notes. Filled in once; every invoice and
  // receipt then carries it. (Accounts — acctdash_invoice_document.)
  legalName     String?
  tagline       String?
  gstin         String?
  sac           String? // HSN/SAC printed against every line
  city          String?
  state         String?
  pin           String?
  logoUrl       String?
  bankName      String?
  accountName   String?
  accountNumber String?
  ifsc          String?
  branch        String?
  accountType   String?
  upi           String?
  invoiceTerms  String? // "Due on Receipt", "Net 30" — printed as Terms
  // Office & Expenses → Business Details. This row IS the business profile:
  // GSTIN, bank and UPI above; PAN (null = fall back to the PAN inside the
  // GSTIN) and TAN (the TRACES login id) are the two it was missing.
  pan           String?
  tan           String?
}

// Office & Expenses — the vendor master. Bills keep the vendor as free text
// (OfficeExpense.vendor); this row only adds what a vendor has once for every
// bill, its GSTIN. A bill's own vendorGstin wins; this is the fallback.
model OfficeVendor {
  id            String   @id @default(cuid())
  name          String   @unique
  gstin         String?
  // "Add Vendor" (Office & Expenses): who to call and how the vendor is paid.
  // All optional; `gstin` above doubles as the GST / Tax ID.
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  paymentTerms  String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Vendor portal (P3, 2026-10-05): the vendor's logins, the assets bought
  // from / serviced by it (Asset.vendorId), and the bills it sent in.
  vendorUsers   VendorUser[]
  assets        Asset[]
  billSubmissions VendorBillSubmission[]
  // Vendor portal v2: false = switched off; its vendor logins cannot sign in.
  isActive      Boolean  @default(true)
}

// Office & Expenses → Government portals. One row per portal (gst | traces |
// incometax): the page last chosen and the address it opens. `pageUrls` is a
// JSON map page -> edited address, so an address fixed for one page is kept
// when the other page is picked. The app stores NO portal password.
model PortalLink {
  id           String    @id @default(cuid())
  portalKey    String    @unique
  selectedPage String?
  url          String?
  pageUrls     String?
  lastEditedAt DateTime?
  lastEditedBy String?
}

// A portal balance typed in by hand for a period — never fetched. periodStart
// and periodEnd are ISO dates, '' for "All time".
model PortalBalance {
  id            String   @id @default(cuid())
  portalKey     String
  periodStart   String   @default("")
  periodEnd     String   @default("")
  enteredAmount Float
  enteredBy     String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([portalKey, periodStart, periodEnd])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  // The prototype's Notifications screen is a central event log across
  // Email / WhatsApp / SMS / In-App (notificationsView, line 10575).
  channel   String? // Email | WhatsApp | SMS | In-App
  recipient String? // who the event was addressed to
  status    String? // Sent (Demo) | Delivered | Failed | Read
}

// Role Catalog "Edit Access" — one row per (role, module). `moduleEnabled` is
// the module toggle; `features` is a JSON object mapping each named feature to
// its seven action flags, e.g.
//   {"Candidate List":{"view":true,"create":false,...}}
// The module/feature catalog itself is code, not data — see
// backend/src/utils/roleAccess.js (ROLE_ACCESS_MODULES / ROLE_FEATURE_ACTIONS),
// mirroring the prototype's roleAccessFor() matrix.
model RoleAccess {
  id            String   @id @default(cuid())
  role          String
  // THE PRODUCT DIMENSION: Product → Module → Feature → Action.
  // '*' is the product-agnostic row (dashboard, reports, administration, and
  // every row written before products existed). A product-specific row is
  // merged OVER the '*' row, so one role name can carry different access in
  // ATS than it does in HRMS without inventing a second role name.
  product       String   @default("*") // * | hrms | ats | accounts
  moduleId      String
  moduleEnabled Boolean  @default(false)
  features      String? // JSON: { featureName: { view, create, edit, delete, approve, export, assign } }
  updatedAt     DateTime @updatedAt

  @@unique([role, product, moduleId])
}

// Company asset inventory — the prototype's Employee Services → Assets tab
// tracks assets that may be unassigned, so this is its own table rather than a
// per-employee EmployeeRecord. Employee-raised asset *requests* stay on
// EmployeeRecord(type: 'ASSET') and feed the Asset Approval screen.
model Asset {
  id            String    @id @default(cuid())
  assetCode     String    @unique
  name          String
  category      String    @default("Laptop")
  status        String    @default("Available") // Available | Assigned | In Repair | Retired
  assignedToId  String?
  assignedTo    Employee? @relation(fields: [assignedToId], references: [id])
  purchaseDate  String?
  purchaseCost  Float? // ₹, user request 2026-10-03
  warrantyUntil String?
  history       String    @default("[]") // JSON array of {at, by, text}
  // Asset report filters (hrms-24 §6). Additive, all nullable: the TYPE is the
  // finer grain under category (e.g. Laptop -> "MacBook Pro 14"), LOCATION is
  // where it sits, and the allocation stamps record the CURRENT allocation
  // (assignedAt/By) and the last hand-back (returnedAt), so the report filters
  // run on the server instead of parsing `history`.
  assetType      String?
  location       String?
  assignedAt     DateTime?
  assignedById   String?
  assignedByName String?
  returnedAt     DateTime?
  // Accounts spec S2 (2026-10-05): purchase / depreciation / disposal details.
  vendor             String?
  invoiceNo          String?
  gstPaid            Float?
  paidVia            String? // Bank | Cash | Payable
  paidBankAccountId  String?
  usefulLifeYears    Float?
  depreciationMethod String? // SL | WDV
  depreciationRate   Float? // % a year
  salvageValue       Float?
  disposalDate       String? // YYYY-MM-DD (Sold / Written off)
  disposalAmount     Float?
  disposalPaidVia    String? // Bank | Cash
  disposalNote       String?
  repairs            AssetRepair[]
  // Vendor portal (P3, 2026-10-05). vendorId is the REAL link to the vendor
  // master; the free-text `vendor` above stays as it is (old rows, imports).
  // serialNumber / amcUntil / serviceRemarks are what a vendor login with
  // "Allow editing" may change (routes/vendorPortal.js), besides warrantyUntil.
  vendorId           String?
  vendorMaster       OfficeVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  serialNumber       String?
  amcUntil           String? // YYYY-MM-DD
  serviceRemarks     String?
  vendorAccess       VendorAssetAccess[]
  documents          AssetDocument[]
  vendorBills        VendorBillSubmission[]

  @@index([vendorId])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Accounts spec S2.2: one row per repair / service of an asset. HRMS owns it;
// Accounts posts a journal per Completed repair with a cost (key per id).
// ---------------------------------------------------------------------------
// VENDOR PORTAL (P3, 2026-10-05) — an outside login for a vendor, isolated
// from every staff role: its own table, its own token, its own server-side
// session (utils/vendorAuth.js). A vendor login never becomes a User.
// ---------------------------------------------------------------------------
model VendorUser {
  id                  String    @id @default(cuid())
  vendorId            String
  vendor              OfficeVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  name                String // contact name
  email               String    @unique // also the username; stored lower-case
  passwordHash        String
  status              String    @default("Active") // Active | Inactive
  canEdit             Boolean   @default(false)
  canViewCost         Boolean   @default(false)
  mustChangePassword  Boolean   @default(true)
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // v2 (2026-10-06): an unused temporary password expires (7 days); the IP of
  // the last sign-in; soft delete; the last 3 password hashes (no reuse).
  tempPasswordExpiresAt DateTime?
  lastLoginIp         String?
  deletedAt           DateTime?
  passwordHistory     String    @default("[]") // JSON [bcrypt hash, ...] newest first
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  access              VendorAssetAccess[]
  sessions            VendorSession[]
  bills               VendorBillSubmission[]

  @@index([vendorId])
}

// Which assets one vendor login sees: a specific asset (assetId) OR a whole
// asset category (category, the Asset.category name). Never both on one row.
model VendorAssetAccess {
  id           String     @id @default(cuid())
  vendorUserId String
  vendorUser   VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)
  assetId      String?
  asset        Asset?     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category     String?
  createdAt    DateTime   @default(now())

  @@unique([vendorUserId, assetId])
  @@unique([vendorUserId, category])
  @@index([assetId])
}

// One row per vendor sign-in; its id is the token's jti. Idle timeout reads
// lastSeenAt, logout / deactivate / password reset set revokedAt.
model VendorSession {
  id            String     @id @default(cuid())
  vendorUserId  String
  vendorUser    VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  lastSeenAt    DateTime   @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  ip            String?
  userAgent     String?

  @@index([vendorUserId])
}

// Field-level asset audit (spec 13): vendor edits, bill uploads / reviews,
// document uploads. No foreign keys: the trail outlives what it describes.
model AssetAuditLog {
  id           String   @id @default(cuid())
  assetId      String?
  vendorId     String?
  vendorUserId String?
  changedById  String? // a staff User id when staff acted
  actorName    String?
  role         String // Vendor | Admin | Accounts
  action       String // Asset edited | Bill uploaded | Bill approved | ...
  field        String?
  oldValue     String?
  newValue     String?
  billId       String?
  documentName String?
  status       String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([assetId])
  @@index([vendorUserId])
  @@index([createdAt])
  @@index([action])
}

// A file kept on an asset (warranty card, AMC contract, service report …),
// stored by utils/attachments.js. Uploaded by staff or a vendor login.
model AssetDocument {
  id             String   @id @default(cuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  docType        String   @default("Other")
  name           String
  mime           String
  size           Int
  file           String
  vendorId       String?
  vendorUserId   String?
  uploadedById   String?
  uploadedByName String?
  // v2: only documents with this flag (or uploaded by the vendor) reach the portal.
  visibleToVendor Boolean @default(false)
  createdAt      DateTime @default(now())

  @@index([assetId])
}

// A bill a vendor sent in through the portal. NOT an accounting record: it
// waits here (PENDING_REVIEW -> VERIFIED -> APPROVED | REJECTED) and only on
// APPROVED does Accounts book it as an OfficeExpense (expenseId), which then
// follows the existing Pending -> Paid workflow.
model VendorBillSubmission {
  id              String       @id @default(cuid())
  billCode        String       @unique // VB-00001
  vendorId        String
  vendor          OfficeVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorUserId    String
  vendorUser      VendorUser   @relation(fields: [vendorUserId], references: [id], onDelete: Restrict)
  assetId         String
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetCode       String?
  assetName       String?
  billNumber      String
  billDate        String // YYYY-MM-DD
  amount          Float // before GST
  gst             Float        @default(0)
  tds             Float        @default(0)
  total           Float // amount + gst
  remarks         String?
  documentFile    String?
  documentName    String?
  documentMime    String?
  documentSize    Int?
  supportingDocs  String       @default("[]") // JSON [{file,name,mime,size,at}]
  status          String       @default("PENDING_REVIEW") // PENDING_REVIEW | VERIFIED | APPROVED | REJECTED
  rejectionReason String?
  reviewRemarks   String?
  submittedByName String?
  submittedAt     DateTime     @default(now())
  verifiedById    String?
  verifiedAt      DateTime?
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  expenseId       String?      @unique // = the Accounts bill (OfficeExpense) id, at most one
  updatedAt       DateTime     @updatedAt
  // v2 (2026-10-06). total = amount + GST − TDS (computed on the server).
  // status also WITHDRAWN (by the vendor, while Pending Review; never deleted).
  source             String    @default("Vendor Portal")
  parentSubmissionId String? // a resubmission after rejection points at the rejected one
  version            Int       @default(1)
  idempotencyKey     String?
  withdrawnAt        DateTime?
  billNumberKey      String? // lower(trim(billNumber)) — the duplicate check
  originalValues     String? // JSON: the vendor's own amount / gst / tds / billNumber / billDate before any Accounts edit

  @@index([vendorId])
  @@index([assetId])
  @@index([status])
  @@unique([vendorUserId, idempotencyKey])
  @@index([vendorId, billNumberKey])
  @@index([parentSubmissionId])
}

model AssetRepair {
  id                String   @id @default(cuid())
  repairNo          String   @unique // RP-00001
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  dateReported      String?
  issue             String?
  repairType        String   @default("Repair") // Repair | Service | AMC | Replacement of part
  vendor            String?
  repairDate        String?
  cost              Float    @default(0)
  gstPaid           Float    @default(0)
  invoiceNo         String?
  paidVia           String? // Bank | Cash | Payable
  paidBankAccountId String?
  underWarranty     Boolean  @default(false)
  capitalise        Boolean  @default(false)
  status            String   @default("Reported") // Reported | In Repair | Completed | Cancelled
  reportedById      String?
  reportedByName    String?
  notes             String?
  slip              String? // JSON
  legacyEntryId     String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([assetId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Administration additions (prototype parity pass)
// ---------------------------------------------------------------------------

// Organization Structure -> approval & escalation workflow (prototype
// adminOrgStructureView, and ORG_STRUCTURE_DEFAULT at line 2260). Requests
// escalate top-to-bottom through this chain; roles can be edited or paused,
// never deleted.
model OrgRole {
  id          String   @id @default(cuid())
  name        String
  description String
  system      Boolean  @default(false) // system roles cannot be paused
  paused      Boolean  @default(false)
  approveDays Int? // can approve leave up to N days; longer requests escalate
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Integrations -> Connections tab. One row per channel in INTEGRATION_CATALOG
// (prototype line 2189). `id` is the catalog id ("whatsapp", "jobportal", ...).
model Integration {
  id             String    @id
  enabled        Boolean   @default(false)
  connected      Boolean   @default(false)
  state          String    @default("Not Connected") // Not Connected | Connected | Expired | Reconnect Required
  values         String? // JSON of the channel's credential fields
  connectedAt    DateTime?
  lastSync       DateTime?
  lastTest       DateTime?
  lastTestResult String?
  recordsSynced  Int       @default(0)
  recordsFailed  Int       @default(0)
  error          String?
  updatedAt      DateTime  @updatedAt

  events IntegrationEvent[]
}

// One row per Connect / Disconnect / Test / Sync run — the Sync History modal.
model IntegrationEvent {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  action        String // Connected | Disconnected | Test Connection | Sync Now
  by            String?
  result        String
  synced        Int         @default(0)
  failed        Int         @default(0)
  entities      String?
  createdAt     DateTime    @default(now())
}

// Job Portal Synchronisation -> the Sync Logs table (Date / Entity / Status /
// Reason). Written by the public Job Portal routes as records come across.
model SyncLog {
  id        String   @id @default(cuid())
  entity    String // Candidates | Applications | Requirements | Job Status
  status    String // Success | Failed
  reason    String?
  recordRef String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Designation -> ATS role mapping (auth_rbac)
//
// THE mapping from HRMS designation to ATS working role. Configurable data,
// never a switch statement: "Recruiter" -> RECRUITER, "TL" -> TL, and the
// department the employee already sits in supplies the scope. The same ATS
// role therefore works in any department — there is no "Medical TL" role.
// Administration -> Users edits these rows.
// ---------------------------------------------------------------------------
model DesignationRole {
  id           String   @id @default(cuid())
  designation  String   @unique
  // A designation derives ALL THREE product roles, not just the ATS one.
  // "Accountant" is HRMS self-service + Accounts=ACCOUNTANT + ATS none;
  // "Recruiter" is HRMS self-service + ATS=RECRUITER + Accounts NONE.
  hrmsRole     String? // EMPLOYEE | TL | STL | MANAGER | … | NONE
  accountsRole String? // ACCOUNTANT | MANAGER | ADMIN | … | NONE
  atsRole      String? // RECRUITER | TL | STL | BDE | MANAGER | ASSISTANT_MANAGER | ADMIN | null
  hrms         Boolean  @default(true)
  ats          Boolean  @default(false)
  accounts     Boolean  @default(false)
  landing      String? // ats | hrms | accounts — preferred workspace
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// =============================================================================
// ROLES — the role catalogue as data (Role & Permission Management).
//
// Seeded with the 13 system roles (isSystem = true); an administrator adds
// custom roles (code CUSTOM_…) with their own permission matrix, stored in
// RoleAccess rows keyed by `code` exactly like a system role's overrides.
// A custom role has NO built-in defaults: deny by default.
//
// scopeLevel (OWN | TEAM | DEPARTMENT | ALL) + behavesLike decide DATA SCOPE
// and ATS stage ownership only (utils/roleRegistry.js); they never grant a
// permission. `permissions` is the simple module x action matrix the Role
// Catalog form edits, kept for display; the engine reads RoleAccess.
// =============================================================================
model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  status      String   @default("Active") // Active | Inactive
  isSystem    Boolean  @default(false)
  scopeLevel  String   @default("OWN") // OWN | TEAM | DEPARTMENT | ALL
  behavesLike String? // JSON { hrms, ats, accounts }: system role codes used for scope / stage ownership
  permissions String? // JSON { rowId: [action, …] } — the Role Catalog matrix
  products    String? // JSON { hrms, ats, accounts }: which product roles it fills
  position    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =============================================================================
// CANDIDATES — pipeline history, communications, notes, documents (cand_)
//
// Four NEW tables. Nothing here alters an existing table: the only schema
// change is CREATE TABLE + CREATE INDEX, so the SQLite table-rebuild trap that
// silently drops columns added by other migrations cannot be triggered.
// The relation fields added to Candidate / Application below are virtual
// (Prisma back-references); they produce no column on those tables.
// =============================================================================

// Pipeline History — the stage chain with Who / When / Action / Comment.
// One row per transition. The Application.stage column stays the single source
// of truth for WHERE a candidate is; this table records HOW they got there.
model ApplicationStageEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStage     String? // null on the first event (application created)
  toStage       String
  action        String // human phrase: "Moved to Client Review", "Rejected", …
  comment       String?
  actorUserId   String?
  actorName     String?
  actorRole     String? // the actor's ATS working role at the time
  createdAt     DateTime    @default(now())

  // --- followup_: the full Rejected / Hold record -------------------------
  // "Rejected and Hold records must keep their full history — candidate,
  // requirement, client, previous stage, who rejected, their role and side,
  // reason category, detailed reason, comments, timestamp."
  //
  // candidateId / fromStage / actorUserId / actorName / actorRole / comment /
  // createdAt were already here. These six close the rest of it. The
  // requirement and client are SNAPSHOTTED, not only joined: a requirement can
  // be retitled and a client renamed, and the record of why someone was
  // rejected has to keep saying what it said at the time.
  //
  // `actorSide` is Internal vs Client — the same rejection reason means two
  // different things depending on which side of the table it came from, and
  // it is never inferred from actorRole at render time.
  requirementId    String?
  requirementTitle String?
  clientId         String?
  clientName       String?
  actorSide        String? // Internal | Client
  reasonCategory   String? // Skills Mismatch | Salary Expectation | …
  reasonDetail     String? // the detailed, free-text reason

  // Which SEAT moved this candidate, at the moment it was moved.
  actorPositionId   String?
  actorPositionCode String?

  @@index([candidateId])
  @@index([applicationId])
  @@index([createdAt])
  @@index([actorPositionCode])
}

// ---------------------------------------------------------------------------
// followup_: THE FOLLOW-UP RECORD.
//
// One row per follow-up COMMITMENT on one application — not on a candidate.
// A candidate with three live applications has three independent follow-up
// threads, because the person chasing them, the thing being chased and the
// date it is due are all properties of the application, never of the person.
//
// Recording a follow-up CLOSES the open one (completedAt, and lastContactedAt
// stamps when contact actually happened) and opens the next. The table is
// therefore the whole follow-up history; the application's CURRENT follow-up
// is simply its newest row with completedAt still null.
//
// STATUS IS DERIVED, NEVER STORED. Upcoming / Due Today / Overdue is a
// function of dueDate and today's date, computed at read time in
// utils/followups.js. A stored status column would be wrong every midnight.
// The one thing that IS stored is completion, because that is an event
// somebody caused rather than a date arithmetic result.
//
// Owner / Owner Role / TL / BDE are snapshotted onto the row for the same
// reason the rejection record snapshots its client: a follow-up that was
// owned by one recruiter and later reassigned must still say who owed it.
// ---------------------------------------------------------------------------
model ApplicationFollowUp {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId   String
  requirementId String?

  ownerUserId String?
  ownerName   String?
  ownerRole   String? // Recruiter | BDE | TL | STL | …
  tlUserId    String?
  tlName      String?
  bdeUserId   String?
  bdeName     String?

  lastContactedAt  DateTime? // when contact actually happened
  contactMode      String? // Call | Email | WhatsApp | SMS | In Person
  nextAction       String? // what is owed next
  dueDate          String? // YYYY-MM-DD — what Upcoming/Due Today/Overdue is measured against
  nextFollowUpAt   String? // YYYY-MM-DD — when the next touch is planned
  notes            String?
  // §8 "What happened?" and §4 the call result — a RECORDED CHOICE, not a
  // sentence somebody may or may not have typed.
  outcome          String?
  // §9 "What should happen next?" — the chosen next step, beside nextAction.
  nextStep         String?
  // A 3:00 PM callback needs the clock as well as the day.
  dueTime          String? // HH:MM
  nextFollowUpTime String? // HH:MM
  // §18-§20 — raised by the SYSTEM at a stage change rather than by a person.
  autoCreated      Boolean   @default(false)
  purpose          String? // Interview confirmation | Client decision | …

  completedAt   DateTime?
  completedById String?
  completedNote String?

  // Escalation, recorded so an alert fires ONCE per rung. The ladder is
  // Owner -> TL -> STL -> Admin -> Super Admin (§11-§13); `escalationLevel` is
  // the rung it has reached, so a dashboard can group by it without
  // re-deriving the answer from four timestamps.
  stlUserId             String?
  stlName               String?
  escalatedTlAt         DateTime?
  escalatedStlAt        DateTime?
  escalatedAdminAt      DateTime?
  escalatedSuperAdminAt DateTime?
  escalationLevel       Int       @default(0)

  createdById       String?
  createdByName     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  // The SEAT that owns this follow-up — what "did this desk do its
  // follow-ups" is counted over.
  ownerPositionId   String?
  ownerPositionCode String?

  @@index([applicationId])
  @@index([candidateId])
  @@index([ownerUserId])
  @@index([dueDate])
  @@index([ownerPositionCode])
}

// Candidate communications — Email / SMS / WhatsApp.
//
// HONEST BY DESIGN: this table is the RECORD and the TRIGGER, not a delivery
// receipt. No mail / SMS / WhatsApp provider is wired into this app, so every
// row is written with status NOT_SENT_NO_PROVIDER and sentAt stays null. A real
// integration would fill providerRef / sentAt / status from the provider's
// callback; see backend/src/utils/candidateComms.js.
model CandidateMessage {
  id               String    @id @default(cuid())
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId    String?
  channel          String // Email | SMS | WhatsApp
  template         String // template key, e.g. INTERVIEW_SCHEDULED
  templateLabel    String?
  trigger          String // what caused it, e.g. "Stage change: Interview"
  recipient        String // the candidate's email / phone, as addressed
  subject          String?
  body             String?
  status           String    @default("NOT_SENT_NO_PROVIDER")
  statusDetail     String?
  // Sender identity comes from the acting EMPLOYEE's record (Employee.email),
  // captured when the employee was added — never a hardcoded from-address.
  senderUserId     String?
  senderEmployeeId String?
  senderName       String?
  senderEmail      String?
  senderSourceNote String? // which record the address came from
  stageFrom        String?
  stageTo          String?
  providerRef      String? // the provider's message id, once it accepted the message
  sentAt           DateTime? // when the provider accepted it — never set otherwise
  // --- delivery bookkeeping (integr_message_delivery) ----------------------
  // Written by utils/mailWorker.js only. A row with attempts > 0 has really
  // been handed to a provider at least once.
  attempts         Int       @default(0)
  lastAttemptAt    DateTime?
  nextAttemptAt    DateTime? // set on a transient failure — the backoff
  lastError        String? // the provider's own words on the last failure
  createdAt        DateTime  @default(now())

  @@index([candidateId])
}

// Internal recruiter / TL notes. NEVER visible to a CLIENT or CANDIDATE login —
// routes/candidates.js refuses the endpoint and omits the field for them.
model CandidateNote {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?
  body          String
  authorUserId  String?
  authorName    String?
  authorRole    String?
  createdAt     DateTime  @default(now())

  @@index([candidateId])
}

// RESUME FILES + VERSIONS (resume_, migration 20261003120000_candidate_resume).
// ONE NEW TABLE, nothing else altered. Every upload is a new ORIGINAL row whose
// bytes are never overwritten (the newest original is the current one); every
// "Edit resume" save is a new EDITED row (v1, v2 …, numbered by createdAt per
// kind) with its structured sections and a generated TeamLink-format PDF/DOCX.
// `file` / `docxFile` are names utils/resumeStore.js generated inside
// <UPLOAD_DIR>/resumes — never a client path. Clients are served EDITED rows
// only (contact details stripped); originals stay internal.
model CandidateResume {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind          String // ORIGINAL | EDITED
  baseResumeId  String? // EDITED: the original it was edited from
  file          String? // ORIGINAL: the uploaded file; EDITED: the generated PDF
  fileName      String? // sanitised display name
  mime          String?
  size          Int?
  sha256        String?
  docxFile      String? // EDITED: the generated DOCX
  text          String? // extracted text (ORIGINAL) / edited plain text (EDITED)
  sections      String? // EDITED: JSON { summary, skills, experience, education, other }
  parsed        String? // JSON: skills, totalExperienceYears, education, location, emails, phones
  parser        String? // free | claude | none
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  hiddenAt      DateTime? // resume_: "wrong file — hide it"; row + file are kept for audit
  hiddenById    String?
  hiddenByName  String?
  hiddenReason  String?

  @@index([candidateId, kind])
}

// Resume / ID / Certificates / Offer / Joining documents.
model CandidateDocument {
  id               String    @id @default(cuid())
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  docType          String // Resume | ID | Certificate | Offer | Joining
  name             String
  note             String?
  // Internal documents (e.g. anything carrying fee or salary detail) are held
  // back from client logins.
  internalOnly     Boolean   @default(false)
  uploadedByUserId String?
  uploadedByName   String?
  createdAt        DateTime  @default(now())

  @@index([candidateId])
  // b5_: the real file (utils/candidateDocStore.js); NULL on old name-only rows
  file          String?
  fileName      String?
  mime          String?
  size          Int?
  sha256        String?
  deletedAt     DateTime? // delete-with-reason: row + file kept for audit, hidden from the tab
  deletedById   String?
  deletedByName String?
  deleteReason  String?
}

// =============================================================================
// TIMESHEET — tasks, task comments, and email verification codes (tsheet_)
//
// THREE NEW TABLES. Nothing here alters an existing table: the migration is
// CREATE TABLE + CREATE INDEX only, so the SQLite table-rebuild trap that
// silently drops columns added by other migrations cannot be triggered.
//
// Task.assigneeId / assignedById are PLAIN SCALARS holding a User.id, not
// Prisma relations — exactly like User.candidateId above. A relation would put
// back-reference fields on User, and this branch does not touch that model.
// =============================================================================

// One row per task on the Timesheet screen's My Tasks list.
model Task {
  id             String    @id @default(cuid())
  name           String
  department     String?
  description    String?
  subTaskName    String?
  status         String    @default("Not Started")
  // Stored as YYYY-MM-DD, the value an <input type="date"> carries. The screen
  // renders them dd-mm-yyyy; the wire format never depends on a locale.
  startDate      String?
  endDate        String?
  // "Dependent Task — No / Yes". `dependsOnId` names the task it waits on when
  // the answer is Yes; the flag alone would say nothing.
  dependent      Boolean   @default(false)
  dependsOnId    String?
  // Who the work is FOR and who handed it over. Both are User.id — one
  // employee = one user = one login, so there is no second identity to pick.
  assigneeId     String
  assignedById   String
  // Names as they stood when the task was created, so a row still reads
  // correctly after someone is renamed or leaves. The ids above stay
  // authoritative for every permission and scope decision.
  assigneeName   String
  assignedByName String
  // The lifecycle stamps. `status` says where the task is NOW; these say when
  // it got there, which is what the report needs to say anything about time.
  startedAt      DateTime?
  completedAt    DateTime?
  // The review leg: 'Not Submitted' -> 'Pending Review' -> 'Approved' or
  // 'Changes Requested'. A task completed before this column existed keeps the
  // default, because it never went through a review.
  reviewState    String    @default("Not Submitted")
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  comments TaskComment[]

  @@index([assigneeId])
  @@index([assignedById])
  @@index([department])
}

// The comment button on the task row. Anyone who can reach the task can read
// and add one — the thread is the task's own audit of what happened.
model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([taskId])
}

// The one-time code Add Employee sends to verify an address before the account
// exists. The code itself is NEVER stored — only a SHA-256 hash of it — and a
// row dies on expiry, on `attempts` reaching the cap, or once consumed.
// Portal login requests and privacy requests (spec B1/B2, 2026-10-03).
//   CLIENT_LOGIN       the owner BDE asks for a client login; Admin/SA/Manager approves + creates
//   CLIENT_DISABLE     the owner BDE asks to disable a client login; Admin disables
//   CANDIDATE_PRIVACY  a candidate's "delete my data" request; Admin handles it (no auto-delete)
model PortalRequest {
  id              String    @id @default(cuid())
  kind            String // CLIENT_LOGIN | CLIENT_DISABLE | CANDIDATE_PRIVACY
  status          String    @default("Pending") // Pending | Approved | Rejected | Done | Cancelled
  clientId        String?
  candidateId     String?
  userId          String?
  name            String?
  email           String?
  portalType      String?
  reason          String?
  requestedById   String?
  requestedByName String?
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([kind, status])
  @@index([clientId])
  @@index([candidateId])
}

model EmailVerification {
  id            String    @id @default(cuid())
  email         String
  purpose       String    @default("employee-signup")
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  verifiedAt    DateTime?
  consumedAt    DateTime?
  requestedById String?
  createdAt     DateTime  @default(now())

  @@index([email])
}

// Documents on an employee's file — as many as needed, of any type (Aadhaar,
// PAN, degree, experience letter, joining documents, other). `file` is the
// name THIS SERVER generated in the upload directory (utils/attachments.js);
// `fileName` is the sanitised original name, for display only.
model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  docType    String
  docName    String?
  file       String
  fileName   String
  mime       String?
  size       Int?
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([employeeId])
}

// Rewards & Recognition -> NOMINATION (hrms-24 §13). A nomination is a REQUEST:
// Nominated -> Pending Review -> Approved / Rejected -> Awarded. Plain scalars
// (no relation fields) so this stays an additive CREATE TABLE and the Employee
// model is untouched. The nominee's ID / name / department / designation are
// snapshotted at nomination time so the record reads as it was decided.
model RecognitionNomination {
  id                 String    @id @default(cuid())
  nomineeId          String // Employee.id
  nomineeCode        String?
  nomineeName        String
  nomineeDepartment  String?
  nomineeDesignation String?
  recognitionType    String
  reason             String
  achievements       String?
  nominationDate     String // YYYY-MM-DD
  comments           String?
  recommendedReward  String?
  docFile            String? // stored name from utils/attachments.js
  docName            String?
  docMime            String?
  docSize            Int?
  status             String    @default("Pending Review") // Nominated | Pending Review | Approved | Rejected | Awarded
  nominatedById      String // User.id
  nominatedByName    String
  reviewerId         String?
  reviewerName       String?
  decision           String? // Approved | Rejected
  remarks            String?
  reviewedAt         DateTime?
  awardedAt          DateTime?
  awardedById        String?
  awardedByName      String?
  awardRecordId      String? // the RECOGNITION EmployeeRecord written on award
  history            String    @default("[]") // JSON array of {at, by, status, note}
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([nomineeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// BIOMETRIC DEVICE — eSSL (ZKTeco) ADMS / iClock push. The device calls
// /iclock on this server; every call from a registered serial refreshes
// lastSeenAt, which is what the Integrations screen reads as its heartbeat.
// Migration 20260928100000_biometric_adms_device.
model BiometricDevice {
  id              String    @id @default(cuid())
  vendor          String
  protocol        String    @default("ADMS/iClock")
  serialNumber    String    @unique
  endpoint        String
  port            Int?
  status          String    @default("Active") // Active | Inactive
  lastSeenAt      DateTime?
  lastSeenIp      String?
  lastRequest     String?
  deviceInfo      String? // JSON of the INFO the device reports (firmware, users, ...)
  attlogStamp     String?
  punchesReceived Int       @default(0)
  lastPunchAt     String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Every ATTLOG line the device pushed, as received. employeeId is set when the
// PIN is mapped to an employee (Employee.biometricPin); unmapped lines wait
// here and are applied when HR maps the PIN.
model BiometricPunchLog {
  id                String   @id @default(cuid())
  deviceSerial      String
  pin               String
  punchAt           String // YYYY-MM-DD HH:MM:SS, device local time
  statusCode        String?
  verifyCode        String?
  raw               String?
  employeeId        String?
  attendancePunchId String?
  createdAt         DateTime @default(now())

  @@unique([deviceSerial, pin, punchAt])
  @@index([pin])
}

// Names enrolled on the device (from its OPERLOG USER lines), to help map PINs.
model BiometricDeviceUser {
  id           String   @id @default(cuid())
  deviceSerial String
  pin          String
  name         String?
  updatedAt    DateTime @updatedAt

  @@unique([deviceSerial, pin])
}

// ---------------------------------------------------------------------------
// PAST ATTENDANCE imported from the old HRMS (PulseHRM CSV exports) —
// migration 20260928140000. Kept exactly as exported. The employee is matched
// by Employee ID (employeeRef) against Employee Management; name, department
// and designation always come from Employee Management, never from the file.
// sourceName is kept only so an Unmatched Employee row can be identified.
model AttendanceHistory {
  id              String   @id @default(cuid())
  employeeRef     String // Employee ID as written in the file
  employeeId      String? // set when the Employee ID matches Employee Management
  matchStatus     String // Matched | Unmatched Employee
  sourceName      String?
  date            String // YYYY-MM-DD
  firstCheckIn    String? // HH:MM:SS as exported
  lastCheckOut    String?
  totalTimeWorked String?
  totalBreak      String?
  totalHours      String?
  workLocation    String?
  punchTimes      String? // every punch of the day, "HH:MM:SS|HH:MM:SS|..."
  sources         String // which files had this day: report, logs
  result          String // what the import did in TeamLink for this day
  importBatch     String
  importedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeRef, date])
  @@index([employeeId, date])
}

model AttendanceHistorySummary {
  id             String   @id @default(cuid())
  employeeRef    String
  employeeId     String?
  matchStatus    String
  sourceName     String?
  periodFrom     String
  periodTo       String
  location       String?
  halfDay        Float?
  present        Float?
  weekOffs       Float?
  publicHolidays Float?
  leaves         Float?
  payableDays    Float?
  totalHours     String?
  importBatch    String
  importedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeRef, periodFrom, periodTo])
}

// A contact purpose a user added (Contact button -> "Why are you contacting
// them?"), shown to everyone after the built-in ones in utils/followups.js.
// template: the message drafted for it; {name} {role} {client} are filled in.
model ContactPurpose {
  id            String   @id @default(cuid())
  audience      String   @default("candidate") // candidate | client
  label         String
  template      String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([audience, label])
}

// Duplicate-client merge (migration 20260928160000). ClientAlias keeps every
// name a merged-away client had (aliasKey = normalised name) so imports and
// search resolve to the surviving client. ClientMerge is the record of each
// merge with a JSON snapshot of the donor rows and counts of what moved.
model ClientAlias {
  id        String   @id @default(cuid())
  clientId  String
  alias     String
  aliasKey  String   @unique
  source    String   @default("merge")
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ClientMerge {
  id            String   @id @default(cuid())
  primaryId     String
  primaryName   String
  donorIds      String // comma-separated
  donorSnapshot String // JSON array of the donor Client rows as they were
  moved         String // JSON counts: requirements, invoices, users, events, ...
  filledFields  String? // JSON: fields filled on the primary from donors
  note          String?
  mergedById    String?
  mergedByName  String?
  createdAt     DateTime @default(now())

  @@index([primaryId])
}

// Small key/value settings store. key "fit" = { weights, defaultMinFit } (fit_).
model AppSetting {
  key           String   @id
  value         String // JSON
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @default(now()) @updatedAt
}

// Employee Management -> Manage Fields (HRMS item 15). Admin-defined extra
// fields on the employee form. Plain scalars, no relations (additive tables).
model EmployeeField {
  id          String   @id @default(cuid())
  key         String   @unique // slug, stable even if the label changes
  label       String
  type        String // TEXT | NUMBER | DATE | DROPDOWN | MULTISELECT | CHECKBOX | FILE
  options     String? // JSON array of choices (DROPDOWN / MULTISELECT)
  required    Boolean  @default(false)
  minValue    Float?
  maxValue    Float?
  maxLength   Int?
  helpText    String?
  active      Boolean  @default(true) // removed fields that hold values are switched off, not deleted
  position    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmployeeFieldValue {
  id          String   @id @default(cuid())
  fieldId     String
  employeeId  String
  value       String? // text / number / YYYY-MM-DD / JSON array / "true"|"false"
  fileStored  String? // utils/attachments.js stored name (FILE fields)
  fileName    String?
  fileMime    String?
  fileSize    Int?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fieldId, employeeId])
  @@index([employeeId])
}

// STATIONERY / CONSUMABLES (Employee Services -> Stationery, user 2026-10-05):
// counted things (notepads, pens ...), not unique assets — no code per pen.
// Balance of an item = SUM(StationeryStock.quantity)
//                    - SUM(StationeryIssue.quantity WHERE kind = 'ISSUE')
//                    + SUM(StationeryIssue.quantity WHERE kind = 'RETURN').
// Additive tables only. employeeId is a plain scalar (no relation), so the
// Employee model and every existing delete path are untouched.
model StationeryItem {
  id           String            @id @default(cuid())
  name         String            @unique // Notepad, Pen, Pencil, Marker ...
  unit         String            @default("pcs")
  reorderLevel Int? // warn when "left" is at or below this
  active       Boolean           @default(true) // hidden from pickers, history kept
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  stock        StationeryStock[]
  issues       StationeryIssue[]
}

// One row per stock-in (HR "adds" a quantity).
model StationeryStock {
  id          String         @id @default(cuid())
  itemId      String
  item        StationeryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity    Int // > 0
  date        String // YYYY-MM-DD
  vendor      String?
  costPerUnit Float? // Rs
  billNo      String?
  note        String?
  addedById   String?
  addedByName String?
  createdAt   DateTime       @default(now())

  @@index([itemId])
  @@index([date])
}

// One row per hand-out (kind ISSUE) or take-back (kind RETURN), quantity > 0.
// batchId groups the rows of one "Give to many".
model StationeryIssue {
  id           String         @id @default(cuid())
  itemId       String
  item         StationeryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  employeeId   String
  quantity     Int
  kind         String         @default("ISSUE") // ISSUE | RETURN
  date         String // YYYY-MM-DD
  note         String?
  batchId      String?
  issuedById   String?
  issuedByName String?
  createdAt    DateTime       @default(now())

  @@index([employeeId])
  @@index([itemId])
  @@index([date])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// RECRUITER JOININGS (2026-10-05) — "4 joinings a month" per recruiter, the
// joinings counted from ATS (utils/recruiterJoinings.js), and Super Admin's
// decision per recruiter per month. Plain scalars (no relations), so the
// migration is ADD TABLE only.
// ---------------------------------------------------------------------------
// The joinings target: scope ALL (everyone, scopeKey ''), DEPARTMENT (scopeKey
// = department name) or EMPLOYEE (scopeKey = Employee.id), from fromMonth
// (YYYY-MM) onward. The most specific, latest-starting rule wins; with none,
// the target is 4.
model RecruiterJoiningTarget {
  id        String   @id @default(cuid())
  scope     String // ALL | DEPARTMENT | EMPLOYEE
  scopeKey  String   @default("")
  fromMonth String // YYYY-MM
  target    Int
  note      String?
  setById   String?
  setByName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeKey, fromMonth])
}

// One decision per recruiter (Employee) per month of joinings.
model RecruiterJoiningDecision {
  id              String   @id @default(cuid())
  employeeId      String
  month           String // YYYY-MM the joinings were made in
  joinings        Int      @default(0) // snapshot at decision time
  target          Int      @default(0) // snapshot at decision time
  decision        String // INCENTIVE | RAISE | NONE
  amount          Float? // INCENTIVE: rupees
  payMonth        String? // INCENTIVE: the payroll month it is paid in (YYYY-MM)
  payrollEntryId  String? // INCENTIVE: the EmployeePayrollRun that carries it
  salaryVersionId String? // RAISE: the SalaryStructureVersion it created
  raiseFrom       String? // RAISE: effective month (YYYY-MM)
  note            String?
  decidedById     String?
  decidedByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([month])
  @@index([payMonth, decision])
}

// B8 semantic matching: cached AI embedding vectors (Float32 bytes) per candidate / job.
model SemanticVector {
  id        String   @id @default(cuid())
  kind      String // CANDIDATE | REQUIREMENT
  refId     String
  model     String // e.g. nomic-embed-text
  hash      String // sha1 of the (PII-stripped) text that was embedded
  dims      Int
  vector    Bytes
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([kind, refId, model])
}

// B5 + B6 (2026-10-06): candidate consent / certifications / referrals / campus / campaigns
model CandidateCertification {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name          String
  issuer        String?
  issuedOn      String? // YYYY-MM-DD
  expiresOn     String? // YYYY-MM-DD
  credentialId  String?
  file          String?
  fileName      String?
  mime          String?
  size          Int?
  sha256        String?
  source        String    @default("Manual") // Manual | Resume
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())

  @@index([candidateId])
}

model ReferralCode {
  id         String   @id @default(cuid())
  code       String   @unique
  userId     String   @unique
  employeeId String?
  name       String
  createdAt  DateTime @default(now())
}

model CandidateReferral {
  id                  String    @id @default(cuid())
  referrerUserId      String?
  referrerEmployeeId  String?
  referrerName        String
  via                 String // FORM | LINK | RECRUITER
  code                String?
  candidateId         String
  applicationId       String?
  requirementId       String?
  note                String?
  bonusAmount         Float?
  bonusStatus         String? // PROPOSED | APPROVED | REJECTED
  bonusNote           String?
  bonusProposedById   String?
  bonusProposedByName String?
  bonusProposedAt     DateTime?
  bonusDecidedById    String?
  bonusDecidedByName  String?
  bonusDecidedAt      DateTime?
  createdById         String?
  createdByName       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([referrerUserId])
  @@index([candidateId])
  @@index([applicationId])
}

model CampusDrive {
  id            String   @id @default(cuid())
  collegeName   String
  driveDate     String // YYYY-MM-DD
  location      String?
  requirementId String?
  department    String?
  cost          Float?
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([driveDate])
}

model SourcingCampaign {
  id            String   @id @default(cuid())
  key           String   @unique // lower-case utm_campaign
  name          String
  source        String?
  medium        String?
  cost          Float?
  startDate     String?
  endDate       String?
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// The partner master (Administration -> Company Setup -> Partners).
model Partner {
  id               String    @id @default(cuid())
  code             String?   @unique // PRT-0001
  type             String    @default("Agency") // Agency | Freelancer
  name             String
  contactName      String?
  email            String?
  phone            String?
  gstin            String?
  pan              String?
  gstRegistered    Boolean   @default(false) // true = GST (18%) is added to the fee
  tdsSection       String?   @default("194J")
  tdsPercent       Float     @default(10)
  feeType          String    @default("PERCENT") // PERCENT (of annual CTC) | FIXED (per joining)
  feePercent       Float?
  feeFixed         Float?
  paymentTermsDays Int       @default(30)
  guaranteeDays    Int       @default(90)
  ownershipDays    Int       @default(365)
  departments      String? // comma list of departments they may submit to; empty = any
  specialisations  String? // comma list (free text / master names)
  showClientName   Boolean   @default(false) // may the partner see the client name on shared jobs
  agreementFile    String?
  agreementName    String?
  agreementMime    String?
  agreementSize    Int?
  agreementFrom    String? // YYYY-MM-DD
  agreementTo      String? // YYYY-MM-DD
  status           String    @default("Active") // Active | Paused
  notes            String?
  createdById      String?
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            PartnerUser[]
  shares           PartnerJobShare[]
  submissions      PartnerSubmission[]
  payouts          PartnerPayout[]

  @@index([status])
}

// A partner login — never a User; its token uses its own secret (utils/partnerAuth.js).
model PartnerUser {
  id                    String    @id @default(cuid())
  partnerId             String
  partner               Partner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  name                  String
  email                 String    @unique // lower-case; the username
  passwordHash          String
  status                String    @default("Active") // Active | Inactive
  mustChangePassword    Boolean   @default(true)
  passwordChangedAt     DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  tempPasswordExpiresAt DateTime?
  deletedAt             DateTime?
  passwordHistory       String    @default("[]")
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  sessions              PartnerSession[]
  submissions           PartnerSubmission[]

  @@index([partnerId])
}

// One row per partner sign-in; its id is the token's jti (30-min idle, 12 h max).
model PartnerSession {
  id            String      @id @default(cuid())
  partnerUserId String
  partnerUser   PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  lastSeenAt    DateTime    @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  ip            String?
  userAgent     String?

  @@index([partnerUserId])
}

// "Share with partners" on a job: which partner may see / submit to which requirement.
model PartnerJobShare {
  id             String    @id @default(cuid())
  partnerId      String
  partner        Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  requirementId  String
  sharedById     String?
  sharedByName   String?
  sharedAt       DateTime  @default(now())
  revokedAt      DateTime?
  revokedByName  String?
  showClientName Boolean   @default(false) // per share; the partner master flag is the default
  note           String?

  @@unique([partnerId, requirementId])
  @@index([requirementId])
}

// A candidate a partner sent for one shared job. Duplicate rows keep the reason and never own the person.
model PartnerSubmission {
  id                     String      @id @default(cuid())
  code                   String?     @unique // PS-00001
  partnerId              String
  partner                Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  partnerUserId          String
  partnerUser            PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Restrict)
  requirementId          String
  candidateId            String?
  applicationId          String?     @unique
  name                   String
  phone                  String?
  email                  String?
  currentCtc             Float?
  expectedCtc            Float?
  noticePeriod           String?
  location               String?
  skills                 String?
  note                   String?
  resumeFile             String?
  resumeName             String?
  resumeMime             String?
  resumeSize             Int?
  consentTicked          Boolean     @default(false)
  status                 String      @default("Submitted") // Submitted | Duplicate | Screening | Interview | Selected | Joined | Rejected | Dropped
  duplicateReason        String?
  duplicateOfCandidateId String?
  statusAt               DateTime?
  statusNote             String?
  submittedAt            DateTime    @default(now())
  ip                     String?
  updatedAt              DateTime    @updatedAt

  @@index([partnerId])
  @@index([requirementId])
  @@index([candidateId])
  @@index([status])
}

// Money owed to a partner for one joining (Draft -> Approved -> Paid, or Cancelled);
// kind CLAWBACK = a negative payout recorded when a paid placement leaves inside the guarantee.
model PartnerPayout {
  id                   String    @id @default(cuid())
  number               String?   @unique // PP-2026-0001
  kind                 String    @default("PAYOUT") // PAYOUT | CLAWBACK
  parentPayoutId       String?
  partnerId            String
  partner              Partner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  submissionId         String?
  applicationId        String
  invoiceId            String?
  candidateName        String?
  requirementTitle     String?
  clientName           String?
  joinedOn             String?
  ctc                  Float?
  feeType              String?
  feePercent           Float?
  feeFixed             Float?
  fee                  Float // before GST (negative on a clawback)
  gstPercent           Float     @default(0)
  gst                  Float     @default(0)
  tdsSection           String?
  tdsPercent           Float     @default(0)
  tds                  Float     @default(0)
  net                  Float // fee + gst - tds
  holdUntil            String? // guarantee end (YYYY-MM-DD): cannot be paid before it
  status               String    @default("Draft") // Draft | Approved | Paid | Cancelled
  preparedById         String?
  preparedByName       String?
  approvedById         String?
  approvedByName       String?
  approvedAt           DateTime?
  paidOn               String?
  paidRef              String?
  paidMode             String?
  paidById             String?
  paidByName           String?
  paidAt               DateTime?
  bankTxnId            String?
  expenseId            String?   @unique // the Office & Expenses row booked on approval
  cancelledAt          DateTime?
  cancelledByName      String?
  cancelReason         String?
  partnerInvoiceNumber String?
  partnerInvoiceDate   String?
  partnerInvoiceFile   String?
  partnerInvoiceName   String?
  partnerInvoiceMime   String?
  partnerInvoiceSize   Int?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([partnerId])
  @@index([applicationId])
  @@index([invoiceId])
  @@index([status])
}

// Fill from a file (2026-10-06): the uploaded JD / company profile a job or
// client was filled from. Plain scalars, no relations (additive table).
model SourceDocument {
  id             String   @id @default(cuid())
  target         String // job | client
  entityId       String // Requirement.id / Client.id
  file           String // stored name in <UPLOAD_DIR>/source-docs (utils/docFill.js)
  fileName       String?
  mime           String?
  size           Int?
  sha256         String?
  engine         String? // rule | rule+ai
  fieldsFound    String? // JSON: the field names filled from it
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([target, entityId])
}
