generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so these are plain strings.
// Valid values, enforced in application code (see backend/src/routes):
// Role: SUPER_ADMIN | ADMIN | MANAGER | ASSISTANT_MANAGER | STL | TL | RECRUITER | BDE | CLIENT | ACCOUNTANT | EMPLOYEE
// Priority: Low | Medium | High | Urgent (the prototype's Create Requirement list)
// RequirementStatus: DRAFT | OPEN | CLOSED
// ApplicationStage: NEW | AI_INTERVIEW_REQUIRED | AI_INTERVIEW_SCHEDULED | AI_INTERVIEW_COMPLETED |
//   RECRUITER_REVIEW | RECRUITER_APPROVED | WITH_BDE | BDE_APPROVED | SHARED_WITH_CLIENT |
//   CLIENT_REVIEW | CLIENT_SHORTLISTED | INTERVIEW_SCHEDULED | INTERVIEW_COMPLETED | SELECTED | OFFER |
//   OFFER_ACCEPTED | JOINED | HIRED | REJECTED | HOLD
// InterviewStatus: SCHEDULED | CONFIRMED | STARTED | COMPLETED | PENDING_FEEDBACK |
//   CANCELLED | NO_SHOW | RESCHEDULED
//   (the prototype's recruitment/client interview chain — see
//    backend/src/utils/atsVocab.js INTERVIEW_STATUS_LABELS / INTERVIEW_NEXT)
// AgreementStatus: DRAFT | SENT | CONFIRMED | ACTIVE | CANCELLED | EXPIRED
//   (the reference prototype's agreement lifecycle — a client requirement can
//    only be activated or posted once its agreement reaches ACTIVE)
//
// Stage codes are stored; the exact label a user reads for each one lives in
// backend/src/utils/atsVocab.js (STAGE_LABELS) and is taken verbatim from the
// prototype. Never derive a label from a code.

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  // One login carries ONE product role today. The reference prototype gives each
  // login three independent product roles (hrmsRole / atsRole / accountsRole) on
  // the same account. That split touches every guard, route and screen in the
  // app, so it is deliberately deferred: when it lands, add hrmsRole/atsRole/
  // accountsRole here alongside `role`, backfill them from `role`, and switch
  // middleware/auth.js requireRole() to read the product-specific column. Until
  // then the Users screen derives per-product access from this single value —
  // see backend/src/utils/roleAccess.js (PRODUCT_ACCESS).
  role           String
  atsDepartment  String?
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])

  // Login administration — the prototype's Users screen (usersView, line 9893).
  username       String?
  status         String   @default("Active") // Active | Inactive | Suspended
  branch         String?
  team           String?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requirementsAsRecruiter Requirement[] @relation("RecruiterRequirements")
  requirementsAsBde       Requirement[] @relation("BdeRequirements")
  auditLogs               AuditLog[]
  employee                Employee?
  notifications           Notification[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  location  String?
  createdAt DateTime @default(now())

  // Company / classification — the prototype's Add Client "Basic Info" tab.
  legalName        String?
  website          String?
  ownerDepartment  String?
  yearEstablished  String?
  landline         String?
  status           String?  @default("Active") // Active | Inactive | Suspended
  activeDate       String?
  clientType       String? // Direct | Vendor | Partner
  priority         String?  @default("High") // High | Medium | Low

  // Primary / secondary contact.
  contactName          String?
  contactDesignation   String?
  contactPhone         String?
  contactEmail         String?
  contactWhatsApp      String?
  secondaryContactName      String?
  secondaryContactDesignation String?
  secondaryContactPhone     String?
  secondaryContactEmail     String?
  commPrimary          String? // Email | WhatsApp | Phone
  commSecondary        String?
  commChannels         String? // comma-separated: Email,WhatsApp,SMS

  // Address.
  houseNumber String?
  street      String?
  landmark    String?
  area        String?
  pincode     String?
  country     String? @default("India")
  state       String?

  // Legal & finance — the prototype's "Legal & Finance" tab. These drive both
  // the agreement document and the invoice raised when a candidate joins.
  gst              String?
  pan              String?
  tan              String?
  businessType     String? @default("Private Limited")
  tdsPercent       Float?  @default(10)
  gstPercent       Float?  @default(18)
  paymentTerms     String? @default("Invoice 6 days after joining; payment due within 6 days of invoice")
  guaranteePeriod  String? @default("30 Days")
  invoiceTrigger   String? @default("Candidate Joining")
  paymentDue       String? @default("6 days after invoice")
  commercialNotes  String?
  accountManager   String?
  bdeOwner         String?

  // Risk monitoring tab.
  riskFlag  String? @default("None") // None | Watch | High Risk
  riskNotes String?

  // Service agreement / e-sign flow. The document is generated from the client
  // record, sent for signature, confirmed either by the client's own login or
  // through the tokenised public signing link (see routes/public.js), and then
  // activated — which is what unblocks requirements for this client.
  agreementId        String?   @unique // human-readable reference, e.g. AGR0001
  agreementStatus    String    @default("DRAFT") // DRAFT | SENT | CONFIRMED | ACTIVE | CANCELLED | EXPIRED
  agreementRequired  String?   @default("Yes")
  agreementTemplate  String?   @default("Standard Recruitment / Staffing")
  agreementStart     String?
  agreementEnd       String?
  agreementActivatedAt DateTime?
  agreementDocument  String? // generated agreement text
  agreementFeePercent Float?   @default(8.33) // placement fee, % of annual CTC
  esignToken         String?   @unique // opaque token in the client-facing signing link
  agreementSentAt    DateTime?
  agreementViewedAt  DateTime?
  agreementSignedAt  DateTime?
  agreementSignedBy  String? // full name typed at e-sign time
  agreementSignedByTitle String? // signatory designation

  requirements Requirement[]
  users        User[]
  invoices     Invoice[]
}

model Requirement {
  id            String             @id @default(cuid())
  title         String
  description   String?
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id])
  department    String?
  priority      String             @default("Medium")
  status        String             @default("OPEN") // DRAFT | OPEN | CLOSED
  skills        String? // comma-separated MANDATORY skills, drives candidate matching + JD
  experience    String? // e.g. "5-8" years, shown on the generated job description
  openings      Int                @default(1)

  // Prototype Create Requirement form (openAddRequirementModal / collectRequirementForm).
  internal            Boolean @default(false) // Internal Requirement vs Client Requirement
  closingDate         String?
  jobDescription      String?
  responsibilities    String?
  qualifications      String?
  education           String? @default("Any Degree")
  goodToHaveSkills    String? // comma-separated
  employmentType      String? @default("Full Time")
  workMode            String? @default("Work From Office")
  location            String?
  preferredLocation   String? @default("Any")
  relevantExperience  String?
  joiningTimeline     String? @default("Within 15 Days")
  noticePeriodMax     String? @default("30 Days")
  jobPreference       String? @default("Permanent")
  salaryType          String? @default("Annual CTC")
  currency            String? @default("INR")
  salary              String? // rendered band, e.g. "₹14L - ₹20L"
  tl                  String?
  stl                 String?
  postingSources      String? // comma-separated selected posting sources
  recruiterId   String?
  recruiter     User?              @relation("RecruiterRequirements", fields: [recruiterId], references: [id])
  bdeId         String?
  bde           User?              @relation("BdeRequirements", fields: [bdeId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  applications Application[]
  invoices     Invoice[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  source    String?  @default("TeamLink Website")
  skills    String? // comma-separated MANDATORY skills, scored against Requirement.skills
  experienceYears Float?
  createdAt DateTime @default(now())

  // Prototype Add Candidate form (openAddCandidateModal / acCollectCandidate).
  // These are the signals the prototype's computeMatch() actually scores on —
  // see backend/src/utils/matching.js.
  dob                     String?
  gender                  String?
  location                String?
  preferredLocation       String?
  currentCompany          String?
  currentDesignation      String?
  relevantExperienceYears Float?
  currentSalary           String?
  expectedSalary          String?
  noticePeriod            String? @default("30 Days")
  availability            String? @default("Available after notice period")
  jobPreference           String? @default("Permanent")
  preferredEmploymentType String? @default("Full Time")
  preferredWorkMode       String? @default("Hybrid")
  education               String?
  specialization          String?
  institute               String?
  passingYear             String?
  goodToHaveSkills        String? // comma-separated
  technicalSkills         String? // comma-separated
  softSkills              String? // comma-separated
  resumeName              String?
  resumeScore             Int?
  firstSource             String?
  sourceCampaign          String?
  profileStatus           String? @default("Active")

  applications Application[]
  invoices     Invoice[]
}

model Application {
  id            String            @id @default(cuid())
  candidateId   String
  candidate     Candidate         @relation(fields: [candidateId], references: [id])
  requirementId String
  requirement   Requirement       @relation(fields: [requirementId], references: [id])
  stage         String            @default("NEW")
  interviewStatus   String?
  interviewAt       DateTime?

  // Recruitment / client interview detail — the prototype's `application.interview`
  // object (recruitmentInterviewTab, line 9330). Kept on Application rather than in
  // a parallel model so interviewStatus/interviewAt stay the single source of truth.
  interviewCode        String?  // INT-#### shown in the calendar's first column
  interviewRound       Int      @default(1)
  interviewType        String?  // Client Interview | Internal Panel
  interviewer          String?
  interviewMode        String?  // Online | In Person | Telephonic
  interviewLocation    String?
  interviewMeetingLink String?
  interviewScore       Int?     // recruitment/client score — never mixed with aiInterviewScore
  interviewResult      String?  // Recommended | Hold | Not Selected
  interviewFeedback    String?
  interviewCreatedBy   String?
  interviewCancelReason String?
  interviewRescheduleCount Int  @default(0)
  interviewStartedAt   DateTime?
  interviewCompletedAt DateTime?
  interviewEvents      InterviewEvent[]

  // AI interview detail (the calendar's second tab).
  aiInterviewDeadline  String?
  aiInterviewFeedback  String?

  // Per-application detail the prototype's pipeline columns read from.
  matchScore        Int?
  resumeScore       Int?
  source            String?
  firstSource       String?
  sourceCampaign    String?
  applicationMethod String?  @default("Manual") // Manual | Auto-Apply
  aiInterviewStatus String?  @default("Required")
  aiInterviewScore  Int?
  // Client joining -> Accounts hand-off (prototype confirmClientJoining).
  offeredCtc        Float?
  joiningDate       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([candidateId, requirementId])
}

// Every status move a recruitment/client interview makes, kept in full — the
// prototype's `interview.history` + `interview.rescheduleHistory`. Nothing is
// overwritten silently: a reschedule appends rather than replacing the slot.
model InterviewEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String      // the status this event moved the interview to
  reason        String?     // cancellation / reschedule / no-show reason
  fromSlot      String?     // previous date+time, on a reschedule
  toSlot        String?     // new date+time, on a reschedule
  by            String?     // who did it
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
}

// =============================================================================
// HRMS
// =============================================================================

// Super Admin-managed lists that populate the Department/Team dropdowns
// elsewhere in the app (e.g. adding an employee). Employee.department/team
// stay plain strings (matching the name here) rather than foreign keys, so
// existing employee records never break if a department is later renamed.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  teams Team[]
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([departmentId, name])
}

model Employee {
  id                String   @id @default(cuid())
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id])
  employeeCode      String   @unique
  name              String
  email             String?
  phone             String?
  department        String?
  team              String?
  // The prototype's Employee Management table has STL and TL columns. In the
  // prototype no create path ever writes them (a bug); here the Add Employee
  // form and the Assign Roles modal actually persist them.
  stl               String?
  tl                String?
  designation       String?
  location          String?
  dateOfJoining     DateTime?
  employmentStatus  String   @default("Active") // Active | On Probation | Notice Period | Exit Process | Relieved | Exited
  employeeType      String?  @default("Full-time") // Full-time | Contract | Intern
  dateOfBirth       DateTime?
  gender            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  address           String?
  addressType       String?  // Current | Permanent
  addressLine1      String?
  addressLine2      String?
  city              String?
  district          String?
  state             String?
  country           String?
  postalCode        String?
  bloodGroup        String?
  branch            String?  // office location: Bengaluru | Chennai | Hyderabad, etc.
  shift             String?  @default("General (9:00 AM – 6:00 PM)")
  employmentExperience String? @default("Fresher") // Fresher | Experienced
  educationDetails  String?
  skills            String?
  bankName          String?
  bankAccountNumber String?
  ifscCode          String?
  panNumber         String?
  aadhaarNumber     String?
  uanNumber         String?
  pfNumber          String?
  esiNumber         String?
  onboardingTasks   String?  // JSON array of {task, completed}
  offboardingStatus String?  // null | Serving Notice | Cleared
  offboardingTasks  String?  // JSON array of {task, completed}
  pendingChanges    String?  // JSON array of {field, from, to} awaiting HR approval
  profileStage      String   @default("Assigned") // Assigned | Pending Review | Locked
  isLocked          Boolean  @default(false) // once HR approves the filled-in profile, the employee can no longer self-edit
  unlockRequestReason String? // reason selected when requesting edit access on a locked profile
  unlockRequestStatus String? // null | Pending | Approved | Rejected
  unlockRequestCount  Int     @default(0) // lifetime count, capped (see UNLOCK_REQUEST_LIMIT)
  reportingManagerId String?
  reportingManager    Employee?  @relation("ManagerReports", fields: [reportingManagerId], references: [id])
  directReports       Employee[] @relation("ManagerReports")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attendance             Attendance[]
  punches                AttendancePunch[]
  attendanceRegularizations AttendanceRegularization[]
  leaveRequests          LeaveRequest[]
  payslips               Payslip[]
  records                EmployeeRecord[]
  performanceReviews     PerformanceReview[]
  courseAssignments      CourseAssignment[]
  projectAssignments     ProjectAssignment[]
  surveyResponses        SurveyResponse[]
  acknowledgments        Acknowledgment[]
  salaryStructure        SalaryStructure?
  fnfRequests            FnfRequest[]
  leaveBalances          LeaveBalance[]
  assetsHeld             Asset[]
}

// Generic table backing the smaller, similarly-shaped HRMS self-service areas
// (one Prisma model instead of ~11 near-identical ones): KT, Targets,
// Resignation, Recognition, Disciplinary, Shift Roster, Timesheet, Assets,
// Expense Claims, Helpdesk, Access Requests, Weekly Ideas.
model EmployeeRecord {
  id         String   @id @default(cuid())
  type       String   // KT | TARGET | RESIGNATION | RECOGNITION | DISCIPLINARY | SHIFT | TIMESHEET | ASSET | EXPENSE | HELPDESK | ACCESS_REQUEST | WEEKLY_IDEA
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  detail     String?
  status     String   @default("Open")
  date       String?  // due date / shift date / timesheet date / expense date, as relevant
  amount     Float?   // expense claim amount
  hours      Float?   // timesheet hours
  category   String?  // helpdesk category / expense category / asset type, as relevant
  priority   String?  // helpdesk priority: Low | Medium | High | Urgent
  progressPct Int?    // 0-100, for targets/goals
  location   String?  // expense claim location / travel destination
  // Helpdesk-specific columns (see backend/src/routes/helpdesk.js). Nullable with
  // defaults so every other record type is unaffected.
  assignedTo String?  // Employee.id of the agent the ticket is assigned to
  resolution String?  // resolution note, required when moving to Resolved/Closed
  resolvedAt String?  // YYYY-MM-DD the ticket was resolved/closed
  escalated  Boolean  @default(false)
  csat       Int?     // 1-5 satisfaction rating, set after resolution
  notes      String?  // JSON array of {author, text, internal}
  // Columns the prototype's Performance & Development screens need. All
  // nullable, so every other record type is unaffected.
  achieved   Float?   // TARGET: achieved vs `amount` (the target)
  unit       String?  // TARGET: the unit both figures are counted in (e.g. "hires")
  fromName   String?  // KT: who ran the session · RECOGNITION: who gave the award
  toName     String?  // KT: who received the handover
  raisedBy   String?  // DISCIPLINARY: who logged the case
  points     Int?     // RECOGNITION: award points, which drive the leaderboard
  aiNote     String?  // WEEKLY_IDEA: the AI review note recorded with the decision
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Named shift patterns (e.g. Morning 09:00–18:00) that employees are rostered
// into — Shift & Roster assigns an employee to one of these per date via
// EmployeeRecord(type: 'SHIFT').
model ShiftPattern {
  id        String   @id @default(cuid())
  name      String
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String   // YYYY-MM-DD
  status     String   // Present | Absent | Late | Half Day | Leave
  checkIn    String?
  checkOut   String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
}

// One raw device punch. Attendance (above) is the day's *marked* status; punches
// are the underlying check-in/check-out events a biometric reader, the web app or
// the mobile app records. First-in / last-out, worked hours and lateness are all
// derived from these rather than stored — see backend/src/routes/attendance.js.
model AttendancePunch {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       String   // YYYY-MM-DD
  time       String   // HH:MM, 24-hour
  direction  String   @default("In") // In | Out
  method     String   @default("Web Check-in") // Web Check-in | Mobile App | Biometric (Fingerprint)
  location   String?
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

// A request to correct a punch after the fact (missing/incorrect check-in or check-out).
model AttendanceRegularization {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  date             String
  requestedCheckIn String?
  requestedCheckOut String?
  reason           String?
  status           String   @default("Pending") // Pending | Approved | Rejected
  createdAt        DateTime @default(now())
  decidedAt        DateTime?
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String   // Sick | Casual | Earned | Unpaid
  fromDate   String
  toDate     String
  days       Float?   @default(1) // calendar days applied for — drives the balance decrement
  reason     String?
  status     String   @default("Pending") // Pending | Approved | Rejected | Cancelled
  // Captured at decision time: approvals of >= HrConfig.leaveReasonThresholdDays must
  // pick one of the configured LeaveReason labels; rejections must give free text.
  approvalReason String?
  rejectReason   String?
  decidedBy      String?
  createdAt  DateTime @default(now())
  decidedAt  DateTime?
}

// Per-employee, per-leave-type entitlement ledger. `total` is the entitlement for
// the current cycle (seeded from the LeaveType cap) and `taken` is incremented when
// a request is approved, so the Leave Balances report can show remaining/total.
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String   // LeaveType.name
  total      Float    @default(0)
  taken      Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, type])
}

// Configurable leave policy — types, caps, and the reasons offered when approving.
model LeaveType {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  cap     Int     @default(0)
  unit    String  @default("yr") // yr | month | unpaid
  carries Boolean @default(false)
  active  Boolean @default(true)
}

model LeaveReason {
  id     String  @id @default(cuid())
  label  String
  active Boolean @default(true)
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      String
  type      String?  @default("Festival") // National Holiday | Festival | Optional
  createdAt DateTime @default(now())
}

model Payslip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  month      String   // YYYY-MM
  basic      Float
  hra        Float
  allowances Float
  deductions Float
  netPay     Float
  // Detailed breakup, mirroring the reference app's payslip components.
  bonus            Float? @default(0)
  specialAllowance Float? @default(0)
  employerPf       Float? @default(0)
  employeePf       Float? @default(0)
  professionalTax  Float? @default(0)
  gratuity         Float? @default(0)
  lopDays          Float? @default(0) // loss-of-pay days deducted this cycle
  gross            Float? @default(0) // basic + hra + bonus + special allowance
  // Excess late arrivals beyond HrConfig.freeLateArrivalsPerMonth cost half a day's
  // pay each: lateCut = halfDayCut * round(net / 60). Deducted from netPay.
  lateCut          Float? @default(0)
  lateDays         Float? @default(0)
  payMode          String? @default("Package") // Package | Stipend
  generatedAt DateTime @default(now())

  @@unique([employeeId, month])
}

// One payroll cycle. Created as "Processing" by POST /api/payroll/run and moved to
// "Paid" by PATCH /api/payroll/runs/:id/paid, giving the Payroll history and the
// month-over-month comparison on the Reports tab something to read.
model PayrollRun {
  id              String   @id @default(cuid())
  month           String   @unique // YYYY-MM
  period          String   // "September 2026"
  department      String?  // null = every department
  status          String   @default("Processing") // Processing | Paid
  employees       Int      @default(0)
  totalGross      Float    @default(0)
  totalDeductions Float    @default(0)
  totalLateCuts   Float    @default(0)
  totalNet        Float    @default(0)
  processedBy     String?
  processedAt     DateTime @default(now())
  paidAt          DateTime?
}

// One employee's pay structure — either a flat Stipend, or a Package broken
// into Basic/HRA/Bonus/Special Allowance with PF/PT deductions and employer
// costs, matching the reference app's CTC breakup.
model SalaryStructure {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  employee         Employee @relation(fields: [employeeId], references: [id])
  payMode          String   @default("Package") // Package | Stipend
  ctc              Float    @default(0)
  stipend          Float    @default(0)
  basic            Float    @default(0)
  hra              Float    @default(0)
  bonus            Float    @default(0)
  specialAllowance Float    @default(0)
  employerPf       Float    @default(0)
  employeePf       Float    @default(0)
  professionalTax  Float    @default(0)
  gratuity         Float    @default(0)
  updatedAt        DateTime @updatedAt
}

// Full & Final settlement request, raised when an employee's offboarding completes.
model FnfRequest {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  lastWorkingDate  String
  status           String   @default("Pending") // Pending | Processed
  settlementAmount Float?
  createdAt        DateTime @default(now())
  processedAt      DateTime?
}

// =============================================================================
// ACCOUNTS
// =============================================================================

model Invoice {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  candidateId     String?
  candidate       Candidate? @relation(fields: [candidateId], references: [id])
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id])
  amount          Float
  gst             Float     @default(0)
  tds             Float     @default(0)
  status          String    @default("Pending") // Pending | Partially Paid | Paid | Overdue | Cancelled
  invoiceDate     String
  dueDate         String?
  paymentTerms    String?   @default("Invoice 6 days after joining; payment due within 6 days of invoice")
  // Commercial trail for an invoice raised from ATS on candidate joining.
  feePercent      Float?
  offeredCtc      Float?
  joiningDate     String?
  createdAt       DateTime  @default(now())

  // Accounts depth — human-facing number, money actually received, and the
  // bank line that finally closed the invoice off.
  invoiceNumber   String?   @unique
  receivedAmount  Float     @default(0)
  paidDate        String?
  bankTxnId       String?
  notes           String?

  // Invoice register depth — the prototype's "Sent" and "TDS certificate"
  // columns, and the GST / TDS rate actually applied to this one invoice
  // (a client's standing rate can be overridden per deal).
  sentVia         String?
  sentDate        String?
  tdsCertReceived Boolean   @default(false)
  tdsCertRef      String?
  tdsCertDate     String?
  gstPercent      Float?
  tdsPercent      Float?

  payments        InvoicePayment[]
}

// A receipt against an invoice. An invoice can be settled by several of these,
// which is what makes "Partially Paid" a real state rather than a label.
model InvoicePayment {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date          String
  amount        Float
  method        String   @default("Bank Transfer")
  reference     String?
  notes         String?
  bankTxnId     String?
  recordedBy    String?
  createdAt     DateTime @default(now())
}

model BankTransaction {
  id               String   @id @default(cuid())
  date             String
  description      String
  type             String   // Credit | Debit
  amount           Float
  matched          Boolean  @default(false)
  matchedInvoiceId String?
  createdAt        DateTime @default(now())

  // Reconciliation state machine:
  // Unmatched -> Matched -> Reconciled, with Ignored as a parked side state.
  reconStatus      String   @default("Unmatched")
  reference        String?
  balance          Float?
  matchedBy        String?
  matchedDate      String?
  clientName       String?
  importBatch      String?
  ignoredReason    String?
}

model OfficeExpense {
  id            String   @id @default(cuid())
  category      String
  location      String?
  monthlyAmount Float
  createdAt     DateTime @default(now())

  // Office & Business depth — a dated, vendor-attributed bill with its own GST,
  // which is what the month summary, the P&L and the GST position are built on.
  vendor        String?
  expenseDate   String?
  gstAmount     Float    @default(0)
  paidStatus    String   @default("Paid") // Paid | Unpaid
  recurring     Boolean  @default(true)
  notes         String?

  // Office & Business depth — TDS the office deducted from the vendor, the
  // amortisation window behind "Amortised" in the month summary, and the
  // vendor GSTIN without which the input credit cannot be claimed.
  tdsAmount     Float    @default(0)
  frequency     String?  @default("Monthly")
  monthsCovered Int?
  vendorGstin   String?
  paymentMode   String?  @default("Bank Transfer")
  description   String?
  // The vendor's own invoice number — what a GST return is reconciled against.
  billNumber    String?
}

// =============================================================================
// HRMS — long tail
// =============================================================================

model PerformanceReview {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  period         String   // e.g. "2026-H1"
  score          Int      // 0-100
  band           String   // High | Medium | Low
  recommendation String   // Recommended | Not Recommended
  notes          String?
  createdAt      DateTime @default(now())
}

model Course {
  id       String   @id @default(cuid())
  title    String
  category String?  // Onboarding | ATS | Compliance | Soft Skills
  duration String?
  createdAt DateTime @default(now())

  assignments CourseAssignment[]
}

model CourseAssignment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  completed  Boolean  @default(false)
  assignedAt DateTime @default(now())

  @@unique([courseId, employeeId])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("Active") // Active | Completed | On Hold
  createdAt DateTime @default(now())

  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       String?
  assignedAt DateTime @default(now())

  @@unique([projectId, employeeId])
}

model Survey {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("Active") // Active | Closed
  questions String   // JSON-encoded array of question strings
  createdAt DateTime @default(now())

  responses SurveyResponse[]
}

model SurveyResponse {
  id         String   @id @default(cuid())
  surveyId   String
  survey     Survey   @relation(fields: [surveyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  answers    String   // JSON-encoded array of answer strings
  submittedAt DateTime @default(now())

  @@unique([surveyId, employeeId])
}

model PolicyDocument {
  id          String   @id @default(cuid())
  title       String
  category    String?  // Policy | Compliance
  mandatory   Boolean  @default(false)
  published   Boolean  @default(true)
  target      String?  @default("All Employees")
  uploadedBy  String?
  uploadedDate String
  createdAt   DateTime @default(now())

  acknowledgments Acknowledgment[]
}

model Acknowledgment {
  id           String         @id @default(cuid())
  documentId   String
  document     PolicyDocument @relation(fields: [documentId], references: [id])
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id])
  acknowledgedAt DateTime     @default(now())

  @@unique([documentId, employeeId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String?  // Holiday | Policy | General | Event
  pinned    Boolean  @default(false)
  target    String?  @default("All Employees")
  postedBy  String?
  date      String
  createdAt DateTime @default(now())
}

model HrConfig {
  id                            String @id @default(cuid())
  freeLateArrivalsPerMonth      Int    @default(2)
  freeEarlyLogoutsPerMonth      Int    @default(1)
  earliestExcusableEarlyLogout  String @default("17:00")
  // Attendance policy
  graceTimeMinutes              Int    @default(15)
  // Clock time (HH:MM, 24h) after which a check-in punch counts as late. This is
  // what the punch log and the monthly report actually compare against;
  // graceTimeMinutes above stays for the older minutes-after-shift-start reading.
  graceTime                     String @default("09:30")
  halfDayHours                  Float  @default(4)
  fullDayHours                  Float  @default(8)
  // Calendar days of notice an employee serves after resigning.
  noticePeriodDays              Int    @default(45)
  // Payroll policy — how attendance turns into pay
  unmarkedDaysUnpaid            Boolean @default(true)
  weekendsPaid                  Boolean @default(true)
  paidLeaveDaysPerMonth         Int    @default(1)
  // CTC split settings — how every employee's CTC is broken into components.
  // Special Allowance always absorbs whatever's left over so the pieces
  // reconcile exactly back to CTC.
  basicPctOfCtc                 Float  @default(50)
  hraPctOfBasic                 Float  @default(40)
  bonusPctOfBasic               Float  @default(8.33)
  employeePfPctOfBasic          Float  @default(12)
  employerPfPctOfBasic          Float  @default(12)
  employeePfMonthlyCap          Float  @default(1800)
  employerPfMonthlyCap          Float  @default(1800)
  gratuityPctOfBasic            Float  @default(4.81)
  professionalTaxFlat           Float  @default(200)
  // Leave policy — concurrent leave caps
  concurrentLeaveCapPct         Int    @default(30)
  concurrentLeaveCapFlat        Int    @default(2)
  leaveReasonThresholdDays      Int    @default(4)
  // Payroll policy — the rest of the prototype's "How attendance affects pay"
  // switches. Its "minimum hours for a full/half day" read the fullDayHours /
  // halfDayHours above, which are the same numbers.
  payByHours                    Boolean @default(false)
  halfDayBySession              Boolean @default(false)
  sessionSplit                  String  @default("13:00")
  // Approval escalation order (comma-separated roles) — a leave, attendance
  // regularization or issue request climbs this chain top to bottom.
  escalationOrder               String  @default("Recruiter,TL,Manager,Admin,Super Admin")
}

// =============================================================================
// ADMINISTRATION
// =============================================================================

model Company {
  id      String @id @default(cuid())
  name    String
  email   String?
  phone   String?
  address String?
  // Company Setup (prototype companySetupView, line 9693) also carries the
  // headquarters line and the list of employment policies.
  hq       String?
  policies String? // JSON array of policy names, each shown with an Active chip

  // Everything the printable tax invoice prints in its letterhead, its "Place
  // of Supply" line and its payment notes. Filled in once; every invoice and
  // receipt then carries it. (Accounts — acctdash_invoice_document.)
  legalName     String?
  tagline       String?
  gstin         String?
  sac           String? // HSN/SAC printed against every line
  city          String?
  state         String?
  pin           String?
  logoUrl       String?
  bankName      String?
  accountName   String?
  accountNumber String?
  ifsc          String?
  branch        String?
  accountType   String?
  upi           String?
  invoiceTerms  String? // "Due on Receipt", "Net 30" — printed as Terms
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  // The prototype's Notifications screen is a central event log across
  // Email / WhatsApp / SMS / In-App (notificationsView, line 10575).
  channel   String?  // Email | WhatsApp | SMS | In-App
  recipient String?  // who the event was addressed to
  status    String?  // Sent (Demo) | Delivered | Failed | Read
}

// Role Catalog "Edit Access" — one row per (role, module). `moduleEnabled` is
// the module toggle; `features` is a JSON object mapping each named feature to
// its seven action flags, e.g.
//   {"Candidate List":{"view":true,"create":false,...}}
// The module/feature catalog itself is code, not data — see
// backend/src/utils/roleAccess.js (ROLE_ACCESS_MODULES / ROLE_FEATURE_ACTIONS),
// mirroring the prototype's roleAccessFor() matrix.
model RoleAccess {
  id            String   @id @default(cuid())
  role          String
  moduleId      String
  moduleEnabled Boolean  @default(false)
  features      String?  // JSON: { featureName: { view, create, edit, delete, approve, export, assign } }
  updatedAt     DateTime @updatedAt

  @@unique([role, moduleId])
}

// Company asset inventory — the prototype's Employee Services → Assets tab
// tracks assets that may be unassigned, so this is its own table rather than a
// per-employee EmployeeRecord. Employee-raised asset *requests* stay on
// EmployeeRecord(type: 'ASSET') and feed the Asset Approval screen.
model Asset {
  id            String    @id @default(cuid())
  assetCode     String    @unique
  name          String
  category      String    @default("Laptop")
  status        String    @default("Available") // Available | Assigned | In Repair | Retired
  assignedToId  String?
  assignedTo    Employee? @relation(fields: [assignedToId], references: [id])
  purchaseDate  String?
  warrantyUntil String?
  history       String    @default("[]") // JSON array of {at, by, text}
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Administration additions (prototype parity pass)
// ---------------------------------------------------------------------------

// Organization Structure -> approval & escalation workflow (prototype
// adminOrgStructureView, and ORG_STRUCTURE_DEFAULT at line 2260). Requests
// escalate top-to-bottom through this chain; roles can be edited or paused,
// never deleted.
model OrgRole {
  id          String   @id @default(cuid())
  name        String
  description String
  system      Boolean  @default(false) // system roles cannot be paused
  paused      Boolean  @default(false)
  approveDays Int?     // can approve leave up to N days; longer requests escalate
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Integrations -> Connections tab. One row per channel in INTEGRATION_CATALOG
// (prototype line 2189). `id` is the catalog id ("whatsapp", "jobportal", ...).
model Integration {
  id             String    @id
  enabled        Boolean   @default(false)
  connected      Boolean   @default(false)
  state          String    @default("Not Connected") // Not Connected | Connected | Expired | Reconnect Required
  values         String?   // JSON of the channel's credential fields
  connectedAt    DateTime?
  lastSync       DateTime?
  lastTest       DateTime?
  lastTestResult String?
  recordsSynced  Int       @default(0)
  recordsFailed  Int       @default(0)
  error          String?
  updatedAt      DateTime  @updatedAt

  events IntegrationEvent[]
}

// One row per Connect / Disconnect / Test / Sync run — the Sync History modal.
model IntegrationEvent {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])
  action        String      // Connected | Disconnected | Test Connection | Sync Now
  by            String?
  result        String
  synced        Int         @default(0)
  failed        Int         @default(0)
  entities      String?
  createdAt     DateTime    @default(now())
}

// Job Portal Synchronisation -> the Sync Logs table (Date / Entity / Status /
// Reason). Written by the public Job Portal routes as records come across.
model SyncLog {
  id        String   @id @default(cuid())
  entity    String   // Candidates | Applications | Requirements | Job Status
  status    String   // Success | Failed
  reason    String?
  recordRef String?
  createdAt DateTime @default(now())
}
