# Local database backups taken before a data import.
backups/
# A converted copy of the company's own data — real records, not source code.
TeamLink-REAL-DATA-converted.xlsx
# SQLite WAL sidecar files — runtime state, not source.
backend/prisma/*.db-wal
backend/prisma/*.db-shm
# The converted copy of the company's own data.
TeamLink-BATCH2-converted.xlsx
# Generated from live data, for the user to fill in.
TeamLink-DATA-NEEDED.xlsx
TeamLink-BATCH3-converted.xlsx
# omnichannel-web/ was an old plain copy of Green Start; since 2026-10-24 Green Start is the git submodule green-start-app/
# (the old folder may still sit on a PC: never track it again)
omnichannel-web/

# TEST SANDBOX copy of dev.db (backend/scripts/sandbox.js) + its state/log files.
backend/prisma/sandbox.db*

# SAFETY (spec 21, 2026-10-03). Ignoring does NOT remove files git already
# tracks — TeamLink-BATCH3/PULSEHRM-converted.xlsx, backend/integration-key.tmp,
# backend/integration-sync.json and backend/vps-* are still tracked until the
# owner decides on the history clean-up. These lines stop NEW copies.
.env.*
!.env.example
**/.env
*.env.local
# Converted company data and exports with real people in them.
*-converted.xlsx
TeamLink-*-converted*.xlsx
backend/integration-key.tmp
backend/integration-sync.json
backend/vps-*.json
backend/vps-*.txt
*.key.tmp
*key*.tmp
# Databases and their copies, anywhere.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
dev.db.*
# Backups and uploaded files (normally under %USERPROFILE%, never the repo).
.teamlink-backups/
.teamlink-data/
.teamlink-message-jobs/
.teamlink-sandbox/

# The embedded Job Portal's runtime files (heartbeat, pid, log) - backend/src/utils/jobPortalEmbed.js
job-portal-app/run/

# ---- Auto-sync safety (watch-sync.ps1, 2026-10-22): nothing here may ever reach GitHub ----
# keys and certificates
*.pem
*.key
*.p12
*.pfx
# templates stay allowed even though .env.* is ignored above
!.env.*.example
!**/.env.example
!**/.env.*.example
# build output, coverage, logs, editor and tool temp files
coverage/
dist-ssr/
logs/
*.tsbuildinfo
*.tmp
*.swp
*.swo
~$*
Thumbs.db

# database engines' data folders and bundled binaries (found by the auto-sync check, 2026-10-22): real records, never source
pgdata/
pg_wal/
# green-start-app/ and job-portal-app/job_portal-main/ are git SUBMODULES (.gitmodules, ignore = untracked): their runtime data
# (run/, var/, .env, node_modules) is never seen by this repo. The TeamLink-owned helper files for green-start-app/run live in green-start-helpers/.
greenstart-app/var/
*.pdb

# the Job Portal's own live database folder and runtime files: never code (deploy/vps/teamlink-sync.sh also never touches them)
job-portal-app/**/var/
job-portal-app/**/run/
