# __COMPANY__ - its OWN Green Start (Omni-Channel) web address. Written by company-green-install.sh from deploy/vps/company/nginx-omni.conf.tmpl, which follows
# the live Green Start site of TeamLink (/etc/nginx/sites-enabled/greenstart.teamlinks.in) with this company's own name, port and origin. No other nginx file is edited.
# Port 80 only here: "certbot --nginx" adds the https block, the certificate and the redirect.
limit_req_zone $binary_remote_addr zone=gs___ZONE___auth:10m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    access_log /var/log/nginx/__KEY__-omni.access.log;
    error_log  /var/log/nginx/__KEY__-omni.error.log warn;

    # uploads (media, CSV) up to 200 MB plus room
    client_max_body_size 210m;
    limit_req_status 429;

    add_header X-Robots-Tag "noindex, nofollow" always;
    gzip on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # never serve hidden files
    location ~ /\.(?!well-known) {
        return 404;
    }

    # Live inbox (Server-Sent Events): never buffered, kept open for up to an hour
    location = /api/v1/realtime/stream {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Sign-in / sign-up / password calls: a little brake against password guessing
    location ^~ /api/v1/auth/ {
        limit_req zone=gs___ZONE___auth burst=30 nodelay;
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Green Start webhooks (delivery reports, Meta): straight to the API; each address is protected by its own secret or signature inside Green Start.
    location ^~ /api/v1/webhooks/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        client_max_body_size 5m;
        proxy_read_timeout 60s;
    }

    # The public pages of the program (the built website files are shared with TeamLink's Green Start: the same program, read only)
    location = / {
        root /opt/green-start/green-start-web/dist;
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-cache";
    }
    location ~ ^/(pricing|about|contact|docs|blog|industries|legal|data-deletion|unsubscribe)(/.*)?$ {
        root /opt/green-start/green-start-web/dist;
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-cache";
    }
    location ^~ /assets/ {
        root /opt/green-start/green-start-web/dist;
        try_files $uri =404;
        expires 30d;
    }
    location ~ ^/(favicon\.svg|robots\.txt|sitemap\.xml|og-image\.png)$ {
        root /opt/green-start/green-start-web/dist;
        try_files $uri =404;
    }

    # Public API addresses (each protected by Green Start itself)
    location ~ ^/(api/v1/(public|site)/|media/|api/v1/health(/ready)?$|api/v1/data-deletion/status$|api/v1/meta/data-deletion$) {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";
        client_max_body_size 5m;
        proxy_read_timeout 60s;
    }

    # Sign-in, sign-up and the signed-in app: Green Start's own login protects the app; the company's app may frame it.
    location ~ ^/(login|signup|forgot-password|invite/accept|recover-two-factor/(confirm|cancel)|auth/(google/callback|teamlink)|app)(/.*)?$ {
        root /opt/green-start/green-start-web/dist;
        try_files /index.html =404;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "frame-ancestors 'self' __APP_ORIGIN__" always;
    }

    # All API calls straight to this company's Green Start API (cookies kept: Green Start's own login cookies)
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 60m;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        root /opt/green-start/green-start-web/dist;
        try_files $uri /index.html;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-cache";
    }
}
