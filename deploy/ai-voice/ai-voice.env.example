# TeamLink AI phone calls - the SERVER's own details. Copy to /root/ai-voice.env on the VPS, fill in, chmod 600.
# Never commit the filled file. setup-ai-voice.sh reads it.

# --- step 1: free voices (needed for "voices") ---
# Hugging Face read token of the account that accepted ai4bharat/indic-conformer-600m-multilingual (downloads the model once)
HF_TOKEN=

# --- step 2: the phone line (needed for "asterisk") ---
# SIP_MODE=gateway : our own GSM gateway box with SIMs (e.g. Synway SMG) in the office. The BOX connects (registers) to
#                    this server; the script makes its username / password and prints what to type in the box.
#                    Needs only OFFICE_IPS (+ DIAL_FORMAT, TEST_NUMBERS).
# SIP_MODE=trunk   : a SIP trunk from a telecom provider (Tata / Airtel / Jio business...). This server registers to
#                    the provider. Needs SIP_HOST, SIP_USER, SIP_PASS, SIP_PROVIDER_IPS.
SIP_MODE=gateway
OFFICE_IPS=            # gateway mode: the office's public internet IP(s), comma separated (ask the ISP for a static IP)

SIP_HOST=              # trunk mode: e.g. sip.provider.in
SIP_PORT=5060
SIP_USER=              # the SIP account / number
SIP_PASS=
SIP_PROVIDER_IPS=      # the provider's server IPs, comma separated: only they may reach our SIP port
DIAL_FORMAT=10         # how the provider wants numbers: 10 | 0 | 91 | e164  (ask the provider)
CALLER_ID=             # the number candidates see, if the provider lets us set it
TEST_NUMBERS=          # your own mobile(s), comma separated: Test mode calls ONLY these
